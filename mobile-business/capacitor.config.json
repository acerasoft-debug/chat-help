{
  "appId": "com.chathelp.business",
  "appName": "ChatHelp Business",
  "webDir": "www",
  "backgroundColor": "#f6f7fb",
  "appendUserAgent": "ChatHelpBusinessApp/1.1",
  "loggingBehavior": "debug",
  "server": {
    "url": "https://chat-help.com/chat/app.php?src=native",
    "androidScheme": "https",
    "errorPath": "index.html",
    "cleartext": false,
    "allowNavigation": [
      "chat-help.com",
      "*.chat-help.com",
      "checkout.stripe.com",
      "*.stripe.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "backgroundColor": "#f6f7fb",
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "backgroundColor": "#f6f7fb",
    "allowsLinkPreview": false,
    "preferredContentMode": "mobile",
    "contentInset": "never",
    "handleApplicationNotifications": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DEFAULT"
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#f6f7fb",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "StatusBar": {
      "style": "DEFAULT",
      "overlaysWebView": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_chathelp",
      "iconColor": "#B8862B"
    }
  }
}
