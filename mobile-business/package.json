{
  "name": "chathelp-business-app",
  "version": "1.0.0",
  "private": true,
  "description": "ChatHelp Business – native Android/iOS app (Capacitor 6) for the ChatHelp Studio: agents, AI assistant, phone, widget and push notifications",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup:android": "node scripts/setup-platform.js android",
    "setup:ios": "node scripts/setup-platform.js ios",
    "sync:android": "cap sync android && node scripts/patch-android.js",
    "sync:ios": "cap sync ios && node scripts/patch-ios.js",
    "patch:android": "node scripts/patch-android.js",
    "patch:ios": "node scripts/patch-ios.js",
    "assets": "node scripts/assets.js",
    "assets:render": "bash scripts/render-assets.sh",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "build:apk": "cd android && ./gradlew assembleDebug",
    "build:release": "cd android && ./gradlew assembleRelease bundleRelease",
    "check": "node --check scripts/setup-platform.js && node --check scripts/patch-android.js && node --check scripts/patch-ios.js && node --check scripts/assets.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.2",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.2",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.2"
  }
}
