# Canli veri repoya girmez: siparis, satici, uye ve stok dosyalari kisisel veri
# icerir; ayrica sunucu ile repo arasinda catisma yaratir.
*
!.gitignore
!.htaccess
!seed/
!seed/*.json

# İSTİSNA — türetilmiş katalog dosyalari.
# Bunlar kisisel veri degil, araclarin urettigi ve UYGULAMANIN CALISMASI ICIN
# GEREKEN yapilandirma: kategori duzeltmeleri, fotograf kalite indeksi, los
# plani. Depoda olmayinca deploy bunlari gonderemiyor ve canli sitede
# kategoriler yanlisa donuyor, Vault bos kaliyor -- olculdu.
!retail-imported.json
!retail-vault.json
!photo-quality.json
!photo-shape.json
!photo-exclude.json
!category-fix.json
!official-prices.json
!hero-frames.json

# Dis kaynak fotograf hatti: adres listesi ELLE yaziliyor, aday defteri ise
# runner tarafindan yaziliyor. Ikisi de kisisel veri degil; depoda olmazsa
# runner listeyi goremez ve indirdiginin kaydi kaybolur.
!image-sources.json
!photo-candidates.json
