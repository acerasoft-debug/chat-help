# MAXSALES Retail — Apache/LiteSpeed kurallari
# nginx kullaniyorsan bu dosya OKUNMAZ; README'deki nginx karsiliklarina bak.

# ---- temiz URL'ler (istege bagli): /product/<id> -> product.php?id=<id>
<IfModule mod_rewrite.c>
  RewriteEngine On

  # robots.txt ve sitemap.xml dinamik uretiliyor
  RewriteRule ^robots\.txt$   robots.php   [L]
  RewriteRule ^sitemap\.xml$  sitemap.php  [L]

  # /outlet/<lot> ve /product/<id> okunabilir yollar
  RewriteRule ^product/([A-Za-z0-9._-]+)/?$  product.php?id=$1  [L,QSA]
  RewriteRule ^outlet/([A-Za-z0-9._-]+)/?$   outlet.php?lot=$1  [L,QSA]
</IfModule>

# ---- veri ve arac dizinleri web'den kapali
RedirectMatch 404 ^/(.*/)?data/
RedirectMatch 404 ^/(.*/)?tools/

# ---- dizin listelemesi kapali
Options -Indexes

# ---- statik varliklarda uzun onbellek (surum sorgusu ile tazeliyoruz)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 month"
  ExpiresByType image/jpeg            "access plus 1 month"
  ExpiresByType image/png             "access plus 1 month"
  ExpiresByType image/webp            "access plus 1 month"
</IfModule>

# ---- guvenlik basliklari (PHP tarafinda da veriliyor; statik dosyalar icin burada)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
</IfModule>

# ---- yedek/gecici dosyalar servis edilmesin
<FilesMatch "\.(json|log|bak|bak-[0-9-]+|tmp-[a-f0-9]+|lock|key)$">
  Require all denied
</FilesMatch>
