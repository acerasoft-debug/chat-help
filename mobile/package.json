{
  "name": "chathelp-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "ChatHelp — native Android/iOS shell (Capacitor) for chat-help.com/chat",
  "scripts": {
    "sync": "cap sync",
    "add:android": "cap add android",
    "open:android": "cap open android",
    "assets": "capacitor-assets generate --android",
    "patch:android": "node scripts/patch-android.js",
    "setup:android": "cap add android && cap sync android && node scripts/patch-android.js",
    "build:aab": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/browser": "^6.0.3",
    "@capacitor/core": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
