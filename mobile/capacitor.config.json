{
  "appId": "com.acerasoft.chathelp",
  "appName": "ChatHelp",
  "webDir": "www",
  "backgroundColor": "#0a1a3f",
  "server": {
    "url": "https://chat-help.com/chat/",
    "androidScheme": "https",
    "errorPath": "index.html",
    "allowNavigation": [
      "chat-help.com",
      "*.chat-help.com",
      "checkout.stripe.com",
      "*.stripe.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1400,
      "launchAutoHide": true,
      "backgroundColor": "#0a1a3f",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a1a3f",
      "overlaysWebView": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}