{
  "appId": "com.chathelp.app",
  "appName": "ChatHelp",
  "webDir": "www",
  "backgroundColor": "#15151b",
  "server": {
    "url": "https://chat-help.com/chat/",
    "androidScheme": "https",
    "errorPath": "index.html",
    "allowNavigation": [
      "chat-help.com",
      "*.chat-help.com",
      "checkout.stripe.com",
      "*.stripe.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1400,
      "launchAutoHide": true,
      "backgroundColor": "#15151b",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#15151b",
      "overlaysWebView": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
