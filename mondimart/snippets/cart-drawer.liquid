<div class="cart-overlay" id="cart-overlay"></div>
<div class="cart-drawer" id="cart-drawer">

  <!-- Header -->
  <div class="cart-header" style="flex-shrink:0">
    <h3>Mon Panier <span style="opacity:.6;font-weight:400">(<span class="cart-count">{{ cart.item_count }}</span>)</span></h3>
    <button class="cart-close" data-close-cart aria-label="Fermer">×</button>
  </div>

  <!-- Soğuk zincir tespiti -->
  {% assign has_cold = false %}
  {% assign has_meat = false %}
  {% for item in cart.items %}
    {% if item.product.tags contains 'viande' or item.product.tags contains 'halal' %}
      {% assign has_cold = true %}
      {% assign has_meat = true %}
    {% endif %}
    {% if item.product.tags contains 'frais' %}
      {% assign has_cold = true %}
    {% endif %}
  {% endfor %}

  <!-- Free shipping progress bar -->
  {% assign threshold = 14900 %}
  {% assign pct = cart.total_price | times: 100 | divided_by: threshold | at_most: 100 %}
  {% assign remaining = threshold | minus: cart.total_price %}

  <div style="padding:12px 18px;background:linear-gradient(135deg,#f8fdf8,#f0f7f0);border-bottom:1px solid #e0ead0;flex-shrink:0">
    {% if cart.total_price >= threshold %}
      <div style="display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:#2a6b2a;margin-bottom:7px">
        <span style="font-size:18px">🎁</span> Livraison gratuite débloquée !
      </div>
    {% else %}
      <div style="font-size:12px;color:#555;margin-bottom:7px;line-height:1.4">
        Plus que <strong style="color:#2a6b2a">{{ remaining | money }}</strong> pour la livraison gratuite
      </div>
    {% endif %}
    <div style="height:6px;background:#dce8dc;border-radius:6px;overflow:hidden;position:relative">
      <div style="height:100%;width:{{ pct }}%;background:linear-gradient(90deg,#4caf50,#66bb6a);border-radius:6px;transition:width .5s ease"></div>
    </div>
    <div style="display:flex;justify-content:space-between;margin-top:4px;font-size:10px;color:#aaa">
      <span>0€</span><span style="font-weight:600;color:#2a6b2a">149€ = livraison offerte</span>
    </div>
  </div>

  <!-- Soğuk zincir uyarısı -->
  {% if has_cold %}
  <div id="cold-chain-banner" style="padding:10px 18px;background:#e8f4fd;border-bottom:2px solid #b3d9f5;flex-shrink:0;display:flex;align-items:flex-start;gap:10px">
    <span style="font-size:20px;flex-shrink:0">❄️</span>
    <div>
      <div style="font-size:12px;font-weight:700;color:#1565c0;margin-bottom:3px">Livraison Chaîne du Froid</div>
      <div style="font-size:11px;color:#1976d2;line-height:1.5">
        {% if cart.total_price >= threshold %}
          Gratuite — seuil 149€ atteint 🎉
        {% else %}
          🇫🇷 France : <strong>18€</strong> (+1€/kg sup. à 1kg)<br>
          🇧🇪🇱🇺🇪🇸 BE/LU/ES : <strong>24€</strong> (+1€/kg sup. à 1kg)
        {% endif %}
      </div>
    </div>
  </div>
  {% else %}
  <div style="padding:8px 18px;background:#fafafa;border-bottom:1px solid var(--bo);flex-shrink:0;display:flex;align-items:center;gap:8px">
    <span style="font-size:15px">🚚</span>
    <div style="font-size:11px;color:#777;line-height:1.5">
      {% if cart.total_price >= threshold %}
        <strong style="color:#2a6b2a">Livraison gratuite</strong> — seuil 149€ atteint 🎉
      {% else %}
        🇫🇷 France : <strong>8€</strong> (+1€/kg) &nbsp;|&nbsp; 🌍 Europe : <strong>18€</strong> (+2€/kg sup. à 5kg)
      {% endif %}
    </div>
  </div>
  {% endif %}

  <!-- Items - scrollable -->
  <div class="cart-items" id="cart-items-container" style="flex:1;overflow-y:auto;min-height:0">
    {% if cart.item_count == 0 %}
      <div style="text-align:center;padding:48px 20px">
        <div style="font-size:52px;margin-bottom:14px">🛒</div>
        <p style="font-size:15px;font-weight:600;color:var(--tm);margin-bottom:6px">Panier vide</p>
        <p style="font-size:13px;color:var(--tl);margin-bottom:20px">Découvrez nos +1000 produits</p>
        <a href="/collections/all" style="display:inline-flex;align-items:center;gap:8px;background:var(--gl);color:#fff;padding:12px 22px;border-radius:10px;font-size:14px;font-weight:600;text-decoration:none">
          Explorer les produits →
        </a>
      </div>
    {% else %}
      {% for item in cart.items %}
        <div class="cart-item">
          <a href="{{ item.url }}" class="cart-item-img" onclick="window.closeCartDrawer&&window.closeCartDrawer()" style="text-decoration:none;display:block;">
            {% if item.image %}
              <img src="{{ item.image | image_url: width: 144 }}" alt="{{ item.title }}" loading="lazy">
            {% else %}
              <div style="width:100%;height:100%;background:var(--cr);display:flex;align-items:center;justify-content:center;font-size:28px">🛒</div>
            {% endif %}
          </a>
          <div class="cart-item-info">
            <a href="{{ item.url }}" onclick="window.closeCartDrawer&&window.closeCartDrawer()" style="text-decoration:none;"><div class="cart-item-name" style="color:inherit;">{{ item.product.title }}</div></a>
            {% unless item.variant.title == 'Default Title' or item.variant.title == blank %}
              <div class="cart-item-variant">{{ item.variant.title }}</div>
            {% endunless %}
            {% if item.product.tags contains 'viande' or item.product.tags contains 'halal' %}
              <div style="font-size:10px;color:#1565c0;font-weight:600;margin-top:2px">❄️ Chaîne du froid</div>
            {% endif %}
            <div class="cart-item-price">{{ item.final_line_price | money }}</div>
            <div class="cart-qty">
              <button class="qty-btn" data-line="{{ forloop.index }}" data-qty-change="-1">−</button>
              <span data-qty-display>{{ item.quantity }}</span>
              <button class="qty-btn" data-line="{{ forloop.index }}" data-qty-change="1">+</button>
              <button class="qty-btn" onclick="removeCartItem({{ forloop.index }})" aria-label="Supprimer" style="margin-left:4px;color:#c0392b;font-size:16px;opacity:.7">🗑</button>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  <!-- Footer -->
  <div class="cart-footer" style="flex-shrink:0;border-top:1px solid var(--bo);background:#fff">
    <div class="cart-subtotal">
      <span>Sous-total</span>
      <span>{{ cart.items_subtotal_price | money }}</span>
    </div>
    <div class="cart-subtotal">
      <span>Livraison estimée</span>
      <span style="color:{% if cart.total_price >= threshold %}#2a6b2a{% else %}var(--gl){% endif %};font-weight:600">
        {% if cart.total_price >= threshold %}
          Gratuite 🎁
        {% elsif has_cold %}
          ❄️ 18€–24€
        {% else %}
          🚚 8€–18€
        {% endif %}
      </span>
    </div>
    <div class="cart-total">
      <span>Total</span>
      <span>{{ cart.total_price | money }}</span>
    </div>

    <!-- Premium checkout button -->
    <a href="/checkout" class="checkout-btn mm-checkout-cta" onclick="document.body.style.overflow='';"
       style="display:flex;align-items:center;justify-content:center;gap:10px;text-decoration:none;color:#1A3C1A;background:linear-gradient(135deg,#C8A84B,#D4B85A);border-radius:14px;font-weight:700;font-size:15px;padding:15px 20px;letter-spacing:0.01em;box-shadow:0 4px 16px rgba(200,168,75,0.35);transition:all 0.22s ease;position:relative;overflow:hidden;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;flex-shrink:0"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <span>Passer à la caisse</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;flex-shrink:0;margin-left:2px"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
    </a>

    <!-- Trust row -->
    <div style="display:flex;align-items:center;justify-content:center;gap:14px;margin-top:10px;flex-wrap:wrap">
      <span style="display:flex;align-items:center;gap:4px;font-size:10.5px;color:#777;font-weight:600">
        <svg viewBox="0 0 24 24" fill="none" stroke="#2a6b2a" stroke-width="2" width="12" height="12"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        CB · PayPal · Apple Pay
      </span>
      <span style="display:flex;align-items:center;gap:4px;font-size:10.5px;color:#777;font-weight:600">
        <svg viewBox="0 0 24 24" fill="none" stroke="#2a6b2a" stroke-width="2" width="12" height="12"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
        SSL sécurisé
      </span>
      <span style="display:flex;align-items:center;gap:4px;font-size:10.5px;color:#777;font-weight:600">
        <svg viewBox="0 0 24 24" fill="none" stroke="#2a6b2a" stroke-width="2" width="12" height="12"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4z"/></svg>
        Livraison 24h
      </span>
    </div>

    <!-- Mondimart mini branding -->
    <div style="display:flex;align-items:center;justify-content:center;gap:6px;margin-top:12px;padding-top:10px;border-top:1px solid var(--bo)">
      <svg viewBox="0 0 22 22" fill="none" width="16" height="16">
        <circle cx="11" cy="11" r="9" stroke="#C8A84B" stroke-width="1.3"/>
        <ellipse cx="11" cy="11" rx="4.5" ry="9" stroke="#C8A84B" stroke-width="0.9"/>
        <line x1="2" y1="11" x2="20" y2="11" stroke="#C8A84B" stroke-width="0.9"/>
      </svg>
      <span style="font-family:'Fraunces','Playfair Display',Georgia,serif;font-size:14px;font-weight:500;color:var(--tm)">Mondi<em style="font-style:italic;color:#C8A84B">mart</em></span>
    </div>

    <a href="{{ routes.cart_url }}" style="display:block;text-align:center;margin-top:10px;font-size:12px;color:var(--tl);text-decoration:none">
      Voir le panier complet
    </a>
  </div>

</div>
