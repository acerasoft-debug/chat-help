<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="logo-nm">{{ shop.name | split: 'mart' | first }}<em>mart</em></span>
        <p>{{ section.settings.description }}</p>
        <div class="footer-socials">
          {% if section.settings.instagram != blank %}
            <a class="footer-social" href="{{ section.settings.instagram }}" target="_blank" aria-label="Instagram">
              <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.facebook != blank %}
            <a class="footer-social" href="{{ section.settings.facebook }}" target="_blank" aria-label="Facebook">
              <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.tiktok != blank %}
            <a class="footer-social" href="{{ section.settings.tiktok }}" target="_blank" aria-label="TikTok">
              <svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.27 8.27 0 004.84 1.56V6.81a4.85 4.85 0 01-1.07-.12z"/></svg>
            </a>
          {% endif %}
          {% if section.settings.youtube != blank %}
            <a class="footer-social" href="{{ section.settings.youtube }}" target="_blank" aria-label="YouTube">
              <svg viewBox="0 0 24 24"><path d="M23.5 6.19a3.02 3.02 0 00-2.12-2.14C19.54 3.5 12 3.5 12 3.5s-7.54 0-9.38.55A3.02 3.02 0 00.5 6.19C0 8.04 0 12 0 12s0 3.96.5 5.81a3.02 3.02 0 002.12 2.14c1.84.55 9.38.55 9.38.55s7.54 0 9.38-.55a3.02 3.02 0 002.12-2.14C24 15.96 24 12 24 12s0-3.96-.5-5.81zM9.75 15.02V8.98L15.5 12l-5.75 3.02z"/></svg>
            </a>
          {% endif %}
        </div>
      </div>

      <div class="footer-col">
        <h4>
          <span class="footer-h4-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 7h14l-1.5 12.5a2 2 0 0 1-2 1.5h-7a2 2 0 0 1-2-1.5L5 7z"/>
              <path d="M9 7V5a3 3 0 0 1 6 0v2"/>
            </svg>
          </span>
          Boutique
        </h4>
        <a href="/collections/all">Tous les produits</a>
        <a href="/collections/promotions">Promotions</a>
        <a href="/collections/vegan">Vegan & Bio</a>
        <a href="/collections/boucherie">Boucherie Halal</a>
        <a href="/collections/karaca">Karaca</a>
        <a href="/blogs/recettes">Recettes</a>
      </div>

      <div class="footer-col">
        <h4>
          <span class="footer-h4-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"/>
              <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
            </svg>
          </span>
          Cuisines
        </h4>
        <a href="/collections/turque"><span class="ft-flag">🇹🇷</span> Turque</a>
        <a href="/collections/maghrebine"><span class="ft-flag">🇲🇦</span> Maghrébine</a>
        <a href="/collections/francaise"><span class="ft-flag">🇫🇷</span> Française</a>
        <a href="/collections/italienne"><span class="ft-flag">🇮🇹</span> Italienne</a>
        <a href="/collections/espagnole"><span class="ft-flag">🇪🇸</span> Espagnole</a>
        <a href="/collections/asiatique"><span class="ft-flag">🌏</span> Asiatique</a>
      </div>

      <div class="footer-col">
        <h4>
          <span class="footer-h4-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </span>
          Infos
        </h4>
        <a href="/pages/livraison">
          <span class="footer-link-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="13" height="11" rx="1"/><path d="M14 9h4l3 4v4h-7"/><circle cx="6" cy="19" r="2"/><circle cx="17" cy="19" r="2"/></svg>
          </span>
          Livraison & retours
        </a>
        <a href="/pages/faq">
          <span class="footer-link-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </span>
          FAQ
        </a>
        <a href="{{ section.settings.whatsapp }}" target="_blank" rel="noopener">
          <span class="footer-link-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </span>
          WhatsApp
        </a>
        <a href="mailto:{{ section.settings.email }}">
          <span class="footer-link-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/></svg>
          </span>
          E-mail
        </a>
        <a href="/pages/contact">
          <span class="footer-link-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          Notre adresse
        </a>
      </div>

      <div class="footer-col">
        <h4>
          <span class="footer-h4-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="4"/>
              <path d="M4 21a8 8 0 0 1 16 0"/>
            </svg>
          </span>
          Compte
        </h4>
        <a href="/account/login">Se connecter</a>
        <a href="/account/register">Créer un compte</a>
        <a href="/account/orders">Mes commandes</a>
        <a href="/cart">Mon panier</a>
        <a href="/pages/mentions-legales">Mentions légales</a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }} · Paris · France · <a href="/pages/confidentialite" style="color:#6A7E6A">Confidentialité</a> · <a href="/pages/cgv" style="color:#6A7E6A">CGV</a></span>
      <div class="payment-icons">
        <div class="pay-icon">CB</div>
        <div class="pay-icon">PAYPAL</div>
        <div class="pay-icon">APPLE PAY</div>
        <div class="pay-icon">GOOGLE PAY</div>
        <div class="pay-icon">VISA</div>
        <div class="pay-icon">MC</div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "textarea", "id": "description", "label": "Description", "default": "Supermarché mondial à Paris — 8 cuisines du monde, +500 produits authentiques, livrés en 24h partout en France." },
    { "type": "text", "id": "instagram", "label": "Instagram URL", "default": "https://instagram.com/mondimart.fr" },
    { "type": "text", "id": "facebook", "label": "Facebook URL", "default": "https://facebook.com/mondimart.fr" },
    { "type": "text", "id": "tiktok", "label": "TikTok URL", "default": "https://tiktok.com/@mondimart.fr" },
    { "type": "text", "id": "youtube", "label": "YouTube URL", "default": "https://youtube.com/@mondimart" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp URL", "default": "https://wa.me/33600000000" },
    { "type": "text", "id": "email", "label": "Email", "default": "contact@mondimart.fr" }
  ]
}
{% endschema %}
