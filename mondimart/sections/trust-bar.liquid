<div class="trust-bar">
  <div class="trust-inner">
    {% for block in section.blocks %}
      <div class="trust-item" {{ block.shopify_attributes }}>
        <div class="trust-icon">
          {% case block.settings.icon %}
            {% when 'delivery' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="13" height="11" rx="1"/><path d="M14 9h4l3 4v4h-7"/><circle cx="6" cy="19" r="2"/><circle cx="17" cy="19" r="2"/></svg>
            {% when 'gift' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
            {% when 'shield' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 3v7c0 5-3.5 9-8 10-4.5-1-8-5-8-10V5l8-3z"/><polyline points="9 12 11 14 15 10"/></svg>
            {% when 'lock' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            {% when 'headset' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1v-7h3v5z"/><path d="M3 19a2 2 0 0 0 2 2h1v-7H3v5z"/></svg>
            {% when 'leaf' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8C8 10 5.9 16.17 3.82 19.11a1 1 0 0 0 1.71 1.06L7 18"/><path d="M7 18c0-5 3-10 10-10"/><path d="M21 3C18 6 16 9 14 12"/></svg>
            {% when 'star' %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {% else %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          {% endcase %}
        </div>
        <div>
          <strong>{{ block.settings.title }}</strong>
          <span>{{ block.settings.subtitle }}</span>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Barre de confiance",
  "blocks": [
    {
      "type": "item",
      "name": "Élément",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "options": [
          { "value": "delivery", "label": "🚚 Livraison" },
          { "value": "gift", "label": "🎁 Cadeau / Gratuit" },
          { "value": "shield", "label": "🛡 Certifié / Sécurisé" },
          { "value": "lock", "label": "🔒 Paiement sécurisé" },
          { "value": "headset", "label": "🎧 Support client" },
          { "value": "leaf", "label": "🌿 Bio / Naturel" },
          { "value": "star", "label": "⭐ Qualité" }
        ], "default": "delivery" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Express 24h" },
        { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "Paris & toute la France" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre de confiance",
      "blocks": [
        { "type": "item", "settings": { "icon": "delivery", "title": "Express 24h", "subtitle": "Paris & toute la France" } },
        { "type": "item", "settings": { "icon": "gift", "title": "Offerte dès 149€", "subtitle": "Livraison gratuite" } },
        { "type": "item", "settings": { "icon": "shield", "title": "Halal certifié", "subtitle": "Boucherie & épicerie" } },
        { "type": "item", "settings": { "icon": "lock", "title": "Paiement sécurisé", "subtitle": "CB · PayPal · Apple Pay" } },
        { "type": "item", "settings": { "icon": "headset", "title": "Support 7j/7", "subtitle": "FR · AR · TR" } }
      ]
    }
  ]
}
{% endschema %}
