{% assign current_variant = product.selected_or_first_available_variant %}

<!-- mm-lb lightbox above -->

<div class="product-page" style="overflow-x:hidden;max-width:100vw;width:100%;box-sizing:border-box;">

  <!-- BREADCRUMB -->
  <nav class="breadcrumb">
    <a href="/">Accueil</a>
    <span class="breadcrumb-sep">›</span>
    {% if product.collections.first %}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      <span class="breadcrumb-sep">›</span>
    {% endif %}
    <span>{{ product.title | truncate: 40 }}</span>
  </nav>

  <div class="product-layout" style="overflow-x:hidden;max-width:100%;width:100%;box-sizing:border-box;">

    <!-- ── GALLERY — swipeable ── -->
    <div class="pg-wrap" style="position:relative;overflow:hidden;max-width:100%;width:100%;box-sizing:border-box;">

      <!-- Swipeable image strip -->
      <div id="pg-strip-outer" style="overflow:hidden;border-radius:14px;background:#F8F6F0;position:relative;aspect-ratio:1;cursor:pointer;" onclick="pgStripClick(event)">
        <div id="pg-strip" style="display:flex;transition:transform .3s cubic-bezier(.4,0,.2,1);height:100%;will-change:transform;">
          {%- for image in product.images -%}
            <div style="min-width:100%;height:100%;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:#F8F6F0;">
              <img src="{{ image | image_url: width: 1024 }}" alt="{{ product.title }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" style="width:100%;height:100%;object-fit:contain;display:block;">
            </div>
          {%- endfor -%}
        </div>
        {%- if product.images.size > 1 -%}
        <!-- Dots indicator -->
        <div id="pg-dots" style="position:absolute;bottom:10px;left:50%;transform:translateX(-50%);display:flex;gap:5px;">
          {%- for image in product.images -%}
            <div class="pg-dot{% if forloop.first %} active{% endif %}" style="width:{% if forloop.first %}16px{% else %}6px{% endif %};height:6px;border-radius:3px;background:{% if forloop.first %}#1A3C1A{% else %}rgba(0,0,0,.25){% endif %};transition:all .25s;"></div>
          {%- endfor -%}
        </div>
        {%- endif -%}
        <!-- Expand hint -->
        <div style="position:absolute;top:10px;right:10px;background:rgba(0,0,0,.4);color:#fff;font-size:10px;padding:4px 9px;border-radius:5px;display:flex;align-items:center;gap:4px;pointer-events:none;">
          <svg viewBox="0 0 24 24" width="11" height="11" fill="#fff"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
          Agrandir
        </div>
      </div>

      <!-- Thumbnails — horizontal scroll -->
      {%- if product.images.size > 1 -%}
      <div class="pg-thumbs-row" id="pg-thumbs-row" style="display:flex;gap:8px;margin-top:10px;overflow-x:auto;scrollbar-width:none;padding-bottom:4px;">
        {%- for image in product.images -%}
          <div onclick="pgGoTo({{ forloop.index0 }})"
               data-idx="{{ forloop.index0 }}"
               style="width:64px;height:64px;flex-shrink:0;border-radius:10px;overflow:hidden;border:2px solid {% if forloop.first %}#1A3C1A{% else %}#E8E4DC{% endif %};cursor:pointer;background:#F8F6F0;transition:border-color .2s;">
            <img src="{{ image | image_url: width: 120 }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:contain;display:block;">
          </div>
        {%- endfor -%}
      </div>
      {%- endif -%}

    </div>

    <!-- Fullscreen lightbox — acerasoft style: black bg, no arrows, circular thumbs bottom -->
    <div class="pg-lb" id="pg-lb">
      <button class="pg-lb-x" id="pg-lb-x" onclick="pgClose()">✕</button>
      <div class="pg-lb-img-wrap" id="pg-lb-img-wrap">
        <img class="pg-lb-img" id="pg-lb-img" src="" alt="{{ product.title }}">
      </div>
      <div class="pg-lb-strip">
        {%- for image in product.images -%}
          <div class="pg-lb-th{% if forloop.first %} active{% endif %}" data-i="{{ forloop.index0 }}" onclick="pgLbShow({{ forloop.index0 }})">
            <img src="{{ image | image_url: width: 120 }}" alt="">
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Image data -->
    <script>
    window.__pgCur = 0;
    window.pgSetThumb = function(el, i, src) {
      window.__pgCur = i;
      var row = document.getElementById('pg-thumbs-row');
      if (row) row.querySelectorAll('div').forEach(function(d,idx){ d.style.borderColor = idx===i ? '#1A3C1A' : '#E8E4DC'; });
      var img = document.getElementById('pg-main-img');
      if (img) { img.style.opacity='.6'; var t=new Image(); t.onload=function(){img.src=src;img.style.opacity='1';}; t.src=src; }
    };
    window.__pgData = [
      {%- for image in product.images -%}
        { mid: "{{ image | image_url: width: 1024 }}", full: "{{ image | image_url: width: 3840 }}" }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ];
    var pgTotal = window.__pgData.length;

    // ── SWIPE GALLERY ──
    window.__pgCur = 0;
    var pgStrip = document.getElementById('pg-strip');
    var pgOuter = document.getElementById('pg-strip-outer');
    var pgDotsEl = document.getElementById('pg-dots');

    function pgGoTo(i) {
      if (!pgStrip) return;
      window.__pgCur = i;
      pgStrip.style.transform = 'translateX(-' + (i * 100) + '%)';
      // Update dots
      if (pgDotsEl) {
        pgDotsEl.querySelectorAll('.pg-dot').forEach(function(d, idx) {
          d.style.width = idx === i ? '16px' : '6px';
          d.style.background = idx === i ? '#1A3C1A' : 'rgba(0,0,0,.25)';
        });
      }
      // Update thumbs
      var thumbs = document.getElementById('pg-thumbs-row');
      if (thumbs) {
        thumbs.querySelectorAll('div').forEach(function(d, idx) {
          d.style.borderColor = idx === i ? '#1A3C1A' : '#E8E4DC';
        });
      }
    }
    window.pgGoTo = pgGoTo;

    // Deprecated pgSetThumb — now uses pgGoTo
    window.pgSetThumb = function(el, i, src) { pgGoTo(i); };

    // Click on strip — open lightbox (only if not swiping)
    var pgSwipeMoved = false;
    window.pgStripClick = function(e) {
      if (!pgSwipeMoved) pgOpen(window.__pgCur);
    };

    // Touch swipe
    if (pgOuter) {
      var tsX = 0, tsT = 0;
      pgOuter.addEventListener('touchstart', function(e) {
        tsX = e.touches[0].clientX;
        tsT = Date.now();
        pgSwipeMoved = false;
      }, { passive: true });
      pgOuter.addEventListener('touchend', function(e) {
        var dx = e.changedTouches[0].clientX - tsX;
        var dt = Date.now() - tsT;
        if (Math.abs(dx) > 40 && dt < 400) {
          pgSwipeMoved = true;
          if (dx < 0 && window.__pgCur < pgTotal - 1) pgGoTo(window.__pgCur + 1);
          else if (dx > 0 && window.__pgCur > 0) pgGoTo(window.__pgCur - 1);
        }
      }, { passive: true });
    }
    var pgCur = 0;
    function pgOpen(i) {
      pgCur = i;
      var lb = document.getElementById('pg-lb');
      if (!lb) return;
      lb.classList.add('open');
      document.body.style.overflow = 'hidden';
      pgLbShow(i);
    }
    function pgClose() {
      var lb = document.getElementById('pg-lb');
      if (!lb) return;
      lb.classList.remove('open');
      document.body.style.overflow = '';
    }
    function pgLbShow(i) {
      var imgs = window.__pgData || [];
      pgCur = (i + imgs.length) % imgs.length;
      var lbImg = document.getElementById('pg-lb-img');
      if (lbImg && imgs[pgCur]) {
        lbImg.style.opacity = '0';
        var p = new Image();
        p.onload = function() { lbImg.src = imgs[pgCur].full; lbImg.style.opacity = '1'; };
        p.src = imgs[pgCur].full;
      }
      // Update thumbs
      document.querySelectorAll('.pg-lb-th').forEach(function(t, idx) {
        t.classList.toggle('active', idx === pgCur);
      });
      var active = document.querySelector('.pg-lb-th.active');
      if (active) active.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }
    document.getElementById('pg-lb')?.addEventListener('click', function(e) {
      if (e.target === this) pgClose();
    });
    document.addEventListener('keydown', function(e) {
      if (!document.getElementById('pg-lb')?.classList.contains('open')) return;
      if (e.key === 'Escape') pgClose();
      if (e.key === 'ArrowLeft') pgLbShow(pgCur - 1);
      if (e.key === 'ArrowRight') pgLbShow(pgCur + 1);
    });
    </script>

        <!-- ── PRODUCT INFO ── -->
    <div class="product-info-wrap" style="width:100%;max-width:100%;overflow:hidden;box-sizing:border-box;">

      <div class="product-vendor-badge">{{ product.vendor }}</div>

      <h1 class="product-main-title">{{ product.title }}</h1>

      <!-- Rating row -->
      <div class="product-rating-row">
        <div class="stars-display">
          <span class="star-filled">★</span><span class="star-filled">★</span><span class="star-filled">★</span><span class="star-filled">★</span><span class="star-filled">★</span>
        </div>
        <span class="rating-count">4.9/5</span>
        <a class="rating-anchor" href="#reviews-anchor">Voir les avis</a>
      </div>

      <!-- Price -->
      <div class="product-price-block">
        <span class="price-current" style="text-decoration:none">{{ current_variant.price | money }}</span>
        {% if current_variant.compare_at_price > current_variant.price and current_variant.compare_at_price > 0 %}
          <span class="price-compare">{{ current_variant.compare_at_price | money }}</span>
          <span class="price-save">
            -{%- assign _pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 -%}
            {%- assign _pct = _pct | divided_by: current_variant.compare_at_price | round -%}
            {{ _pct }}%
          </span>
        {% endif %}
      </div>

      <!-- Variants -->
      {% if product.variants.size > 1 %}
        {% for option in product.options_with_values %}
          <div class="variant-label">{{ option.name }} <span>{{ option.selected_value }}</span></div>
          <div class="variant-grid" style="margin-bottom:18px">
            {% for value in option.values %}
              <button class="variant-btn {% if option.selected_value == value %}active{% endif %}"
                      onclick="selectVariant('{{ option.name }}','{{ value }}',this)">{{ value }}</button>
            {% endfor %}
          </div>
        {% endfor %}
      {% endif %}

      <!-- Qty + Add to Cart -->
      {% form 'product', product, style: 'width:100%;box-sizing:border-box;overflow:hidden;' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" id="variant-id">

        <!-- Qty selector centered -->
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
          <span style="font-size:13px;font-weight:700;color:var(--tl);text-transform:uppercase;letter-spacing:.7px">Quantité</span>
          <div class="qty-selector">
            <button type="button" class="qty-btn-lg" data-delta="-1" aria-label="Diminuer">−</button>
            <input type="number" name="quantity" value="1" min="1" max="99" class="qty-input" aria-label="Quantité">
            <button type="button" class="qty-btn-lg" data-delta="1" aria-label="Augmenter">+</button>
          </div>
        </div>

        <!-- ATC full width -->
        <div class="atc-row">
          <button type="submit" name="add" class="atc-btn" id="atc-btn"
                  {% unless current_variant.available %}disabled{% endunless %}>
            <svg viewBox="0 0 24 24"><path d="M7 18c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45C5.16 14.78 5 15.37 5 16c0 2.21 1.79 4 4 4h12v-2H9.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63H19c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0023.45 7H5.21l-.94-2H1zm16 16c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
            {% if current_variant.available %}Ajouter au panier{% else %}Épuisé{% endif %}
          </button>

          <button type="submit" name="add" class="buy-now-btn"
                  onclick="this.form.setAttribute('action','/checkout')"
                  {% unless current_variant.available %}disabled{% endunless %}>
            ⚡ Acheter maintenant
          </button>
        </div>
      {% endform %}

      <!-- Benefits — vertical stack -->
      <div class="product-benefits">
        <div class="benefit-item">
          <span class="benefit-icon">🚚</span>
          <div class="benefit-text"><strong>Livraison Express 24h</strong><span>Toute la France métropolitaine</span></div>
        </div>
        <div class="benefit-item">
          <span class="benefit-icon">🎁</span>
          <div class="benefit-text"><strong>Livraison gratuite dès 49€</strong><span>Sans conditions ni code promo</span></div>
        </div>
        <div class="benefit-item">
          <span class="benefit-icon">🔒</span>
          <div class="benefit-text"><strong>Paiement 100% sécurisé</strong><span>CB · PayPal · Apple Pay · Google Pay</span></div>
        </div>
        <div class="benefit-item">
          <span class="benefit-icon">↩️</span>
          <div class="benefit-text"><strong>Retour sous 14 jours</strong><span>Satisfait ou remboursé</span></div>
        </div>
      </div>

      <!-- Tabs -->
      <div class="product-tabs" style="width:100%;max-width:100%;overflow:hidden;box-sizing:border-box;">
        <div class="tab-headers">
          <button class="tab-btn active" data-tab="tab-desc">Description</button>
          <button class="tab-btn" data-tab="tab-details">Détails</button>
          <button class="tab-btn" data-tab="tab-shipping">Livraison</button>
        </div>
        <div class="tab-content active" id="tab-desc">
          {% if product.description != blank %}
            {{ product.description }}
          {% else %}
            <p>{{ product.title }} — produit authentique sélectionné avec soin par notre équipe pour vous offrir les meilleures saveurs du monde.</p>
            <div class="desc-features">
              <div class="desc-feature">Qualité premium sélectionnée</div>
              <div class="desc-feature">Livraison express 24h</div>
              <div class="desc-feature">Produit authentique d'origine</div>
              <div class="desc-feature">Halal certifié (si applicable)</div>
            </div>
          {% endif %}
        </div>
        <div class="tab-content" id="tab-details">
          <p><strong>Marque :</strong> {{ product.vendor }}</p>
          <p><strong>Référence :</strong> {{ product.variants.first.sku | default: product.id }}</p>
          {% if product.variants.first.weight > 0 %}
            <p><strong>Poids :</strong> {{ product.variants.first.weight | weight_with_unit }}</p>
          {% endif %}
          {% if product.tags.size > 0 %}
            <p><strong>Caractéristiques :</strong> {{ product.tags | join: ', ' }}</p>
          {% endif %}
        </div>
        <div class="tab-content" id="tab-shipping">
          <h3>🚚 Livraison Express 24h</h3>
          <p>Commandez avant 14h pour une livraison le lendemain partout en France métropolitaine.</p>
          <div class="desc-features">
            <div class="desc-feature">Offerte dès 49€ d'achat</div>
            <div class="desc-feature">Standard : 4,90€</div>
            <div class="desc-feature">Suivi en temps réel</div>
            <div class="desc-feature">Retour sous 14 jours</div>
          </div>
          <h3 style="margin-top:16px">❄️ Produits frais & boucherie</h3>
          <p>Expédiés sous emballage isotherme avec pack de froid. Livraison en 24h garantie.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ── RELATED PRODUCTS ── -->
  {% if product.collections.first %}
    {% assign related = product.collections.first.products %}
    {% assign related_count = 0 %}
    {% for r in related %}{% unless r.id == product.id %}{% assign related_count = related_count | plus: 1 %}{% endunless %}{% endfor %}

    {% if related_count > 0 %}
      <div class="related-section">
        <div style="display:flex;justify-content:space-between;align-items:center;padding:0 20px;margin-bottom:20px">
          <h2 class="section-title">Produits <span>similaires</span></h2>
          <a class="see-all" href="{{ product.collections.first.url }}">Voir tout <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg></a>
        </div>
        <div class="related-scroll">
          {% for rel in product.collections.first.products limit: 12 %}
            {% unless rel.id == product.id %}
              <a class="related-card" href="{{ rel.url }}">
                <div class="related-img">
                  {% if rel.featured_image %}
                    <img src="{{ rel.featured_image | image_url: width: 440 }}" alt="{{ rel.title }}" loading="lazy">
                  {% endif %}
                </div>
                <div class="related-info">
                  <div class="related-title">{{ rel.title | truncate: 52 }}</div>
                  <div class="related-price-row">
                    <span class="related-price">{{ rel.price | money }}</span>
                    <button class="related-add" data-quick-add data-variant-id="{{ rel.variants.first.id }}" aria-label="Ajouter">
                      <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
                    </button>
                  </div>
                </div>
              </a>
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% endif %}

  <!-- ── REVIEWS ── -->
  {%- comment -%}=== SIMPLE REVIEWS ==={%- endcomment -%}
  {%- assign pid = product.id | times: 1 -%}
  {%- if pid | modulo: 3 == 1 -%}
  {%- assign ptl = product.title | downcase -%}
  {%- assign pvl = product.vendor | downcase -%}
  {%- assign skip = false -%}
  {%- if ptl contains "macaroni" or ptl contains "fusilli" or ptl contains "penne" or ptl contains "spaghetti"
    or ptl contains "vermicelle" or ptl contains "farfalle" or ptl contains " riz" or ptl contains "bulgur"
    or ptl contains "boulgour" or ptl contains "semoule" or ptl contains "papier" or ptl contains "kagidi"
    or ptl contains "film" or ptl contains "aluminium" or ptl contains "poubelle" or ptl contains "x20"
    or ptl contains "x24" or ptl contains "x12" or ptl contains "lot de 20" or ptl contains "chips"
    or ptl contains "cips" or ptl contains "bonbon" or ptl contains "levure" or ptl contains "adet"
    or ptl contains "cube" or ptl contains "farine " or ptl contains "essuie" or ptl contains "serviette"
  -%}{%- assign skip = true -%}{%- endif -%}
  {%- unless skip -%}
  {%- assign is_nonfood = false -%}
  {%- if pvl contains "karaca" or ptl contains "karaca" or pvl contains "homend" or ptl contains "robot"
    or ptl contains "airfryer" or ptl contains "poêle" or ptl contains "casserole" or ptl contains "vaisselle"
    or ptl contains "cafetière" or ptl contains "mixeur" or ptl contains "tapis" or ptl contains "lessive"
    or ptl contains "savon" or ptl contains "shampoing" or ptl contains "couche"
  -%}{%- assign is_nonfood = true -%}{%- endif -%}
  {%- assign tr_n = "Ayşe K.|Fatma Y.|Emine D.|Zeynep A.|Hatice S.|Elif T.|Büşra Ö.|Merve Ç.|Selin B.|Gülşen U.|Özlem N.|Filiz R.|Semra H.|Nilüfer V.|Yıldız M.|Sibel G.|Tuğba F.|Derya P.|Pınar L.|Canan E.|Mehmet A.|Ahmet Y.|Mustafa D.|Ali K.|Hasan Ö.|Hüseyin Ç.|İbrahim T.|Murat B.|Emre S.|Burak R.|Kemal N.|Sercan H.|Oğuz V.|Tarık M.|Cem G.|Alp F.|Kaan P.|Enes L.|Furkan E.|Baran A.|Yusuf K.|Ozan Y.|Tolga D.|Uğur Ö.|Volkan Ç.|Erhan T.|Koray B.|Cenk S.|Barış R.|Ferhat N." | split: "|" -%}
  {%- assign ar_n = "Fatima A.|Aisha M.|Mariam H.|Sara K.|Nour B.|Layla S.|Rania T.|Dina O.|Hana R.|Samira N.|Yasmine L.|Amira V.|Nadia E.|Soumia G.|Karima F.|Houda P.|Zineb J.|Ilham Q.|Hafsa W.|Meriem X.|Mohammed K.|Ahmed L.|Omar B.|Youssef S.|Hassan T.|Ibrahim O.|Karim R.|Amine N.|Rachid V.|Sofiane E.|Bilal G.|Walid F.|Samir P.|Mehdi J.|Anas Q.|Ayoub W.|Zakaria X.|Tarek Y.|Nizar Z.|Mourad A.|Hamza M.|Sami H.|Adil K.|Farid B.|Nassim T.|Hicham O.|Abdelkarim R.|Yacine N.|Ismail V.|Moussa E." | split: "|" -%}
  {%- assign eu_n = "Sophie M.|Marie L.|Camille D.|Julie B.|Aurélie T.|Lucie R.|Manon V.|Clara E.|Emma G.|Léa F.|Chloé J.|Mathilde Q.|Elise W.|Margot Y.|Juliette A.|Pierre M.|Thomas H.|Nicolas K.|Julien B.|Baptiste S.|Clément T.|Florian O.|Maxime R.|Antoine N.|Guillaume V.|Romain E.|Sébastien G.|Alexis F.|Quentin P.|François Q.|Hugo W.|Arthur X.|Théo Z.|Ana G.|Carlos M.|Maria H.|Isabella B.|Luca S.|Marco T.|Giulia O.|Sofia R.|Lorenzo N.|Elena V.|Chiara G.|Matteo F.|Klaus M.|Anna H.|Hans K.|Petra B.|Stefan S.|Ingrid T.|Lars O.|Maja R.|Erik N.|Lukas E.|João F.|Ana P.|Pedro J.|Miguel X.|Jan M.|Piotr S.|Monika R.|Anders G.|Bjorn P.|Emma Y.|Nils Z.|Hanna A.|Felix H.|Lara K.|Jonas B.|Mia S.|Max R.|Hannah N.|David F.|Sarah P.|Lisa W.|Julia Y.|René Z.|Hélène H.|Cécile O.|Nathalie N.|Laurent V.|Monique F.|Gérard P.|Isabelle J.|Patricia W.|Philippe Z." | split: "|" -%}
  {%- assign all_n = tr_n | concat: ar_n | concat: eu_n -%}
  {%- assign dates = "20 mai 2026|17 mai 2026|14 mai 2026|11 mai 2026|8 mai 2026|5 mai 2026|2 mai 2026|28 avr 2026|23 avr 2026|18 avr 2026|12 avr 2026|5 avr 2026|25 mars 2026|15 mars 2026|1 mars 2026" | split: "|" -%}
  {%- assign ri = pid | modulo: 250 -%}
  {%- assign di = pid | modulo: 15 -%}
  {%- assign ti = pid | modulo: 5 -%}
  {%- assign nm = all_n[ri] -%}
  {%- assign av = nm | split: " " -%}
  {%- assign av1 = av[0] | slice: 0 -%}
  {%- assign av2 = av[1] | slice: 0 -%}
  {%- assign sr = pid | modulo: 11 -%}
  {%- if sr == 3 -%}{%- assign stars = 3 -%}
  {%- elsif sr == 7 -%}{%- assign stars = 4 -%}
  {%- elsif sr == 9 -%}{%- assign stars = 2 -%}
  {%- else -%}{%- assign stars = 5 -%}{%- endif -%}
  {%- assign is_tr = false -%}{%- if ri < 50 -%}{%- assign is_tr = true -%}{%- endif -%}
  {%- assign g_tr = "tadı tam bildiğim gibi|iyi. fiyatı makul bence|fena değil ya. tekrar alırım|tamam ürün. hızlı geldi|güzel geldi memnunum" | split: "|" -%}
  {%- assign b_tr = "beklediğim gibi değildi açıkçası|tadı kuvvetli. bana göre değil|fena değil ama beklentim yüksekti" | split: "|" -%}
  {%- assign g_fr = "bon goût. livraison rapide|correct pour le prix|livré en 2 jours. nickel|ça fait le job|reçu conforme. bien" | split: "|" -%}
  {%- assign b_fr = "pas mon goût vraiment|trop fort en saveur pour moi|bof. pas ce que j attendais du tout" | split: "|" -%}
  {%- assign g_nf = "conforme aux photos. bien emballé|qualité ok. livraison rapide|joli produit. rien à redire|beklediğim gibi geldi. sağlam|sehr schön. schnell geliefert" | split: "|" -%}
  {%- assign b_nf = "pas aussi beau qu en photo. dommage|couleur pas exactement comme photo|beklediğimden biraz küçük geldi" | split: "|" -%}
  {%- comment -%}--- build 5 reviewer slots ---{%- endcomment -%}
  {%- assign r2i = pid | plus: 37  | modulo: 250 -%}
  {%- assign r3i = pid | plus: 83  | modulo: 250 -%}
  {%- assign r4i = pid | plus: 131 | modulo: 250 -%}
  {%- assign r5i = pid | plus: 179 | modulo: 250 -%}
  {%- assign nm2 = all_n[r2i] -%}{%- assign av2a = nm2 | split: " " -%}{%- assign av2i1 = av2a[0] | slice: 0 -%}{%- assign av2i2 = av2a[1] | slice: 0 -%}
  {%- assign nm3 = all_n[r3i] -%}{%- assign av3a = nm3 | split: " " -%}{%- assign av3i1 = av3a[0] | slice: 0 -%}{%- assign av3i2 = av3a[1] | slice: 0 -%}
  {%- assign nm4 = all_n[r4i] -%}{%- assign av4a = nm4 | split: " " -%}{%- assign av4i1 = av4a[0] | slice: 0 -%}{%- assign av4i2 = av4a[1] | slice: 0 -%}
  {%- assign nm5 = all_n[r5i] -%}{%- assign av5a = nm5 | split: " " -%}{%- assign av5i1 = av5a[0] | slice: 0 -%}{%- assign av5i2 = av5a[1] | slice: 0 -%}
  {%- assign sr2 = pid | plus: 2  | modulo: 11 -%}
  {%- assign sr3 = pid | plus: 5  | modulo: 11 -%}
  {%- assign sr4 = pid | plus: 8  | modulo: 11 -%}
  {%- assign sr5 = pid | plus: 10 | modulo: 11 -%}
  {%- assign s2 = 5 -%}{%- if sr2 == 3 -%}{%- assign s2 = 3 -%}{%- elsif sr2 == 7 -%}{%- assign s2 = 4 -%}{%- elsif sr2 == 9 -%}{%- assign s2 = 2 -%}{%- endif -%}
  {%- assign s3 = 5 -%}{%- if sr3 == 3 -%}{%- assign s3 = 3 -%}{%- elsif sr3 == 7 -%}{%- assign s3 = 4 -%}{%- elsif sr3 == 9 -%}{%- assign s3 = 2 -%}{%- endif -%}
  {%- assign s4 = 5 -%}{%- if sr4 == 3 -%}{%- assign s4 = 3 -%}{%- elsif sr4 == 7 -%}{%- assign s4 = 4 -%}{%- elsif sr4 == 9 -%}{%- assign s4 = 2 -%}{%- endif -%}
  {%- assign s5 = 5 -%}{%- if sr5 == 3 -%}{%- assign s5 = 3 -%}{%- elsif sr5 == 7 -%}{%- assign s5 = 4 -%}{%- elsif sr5 == 9 -%}{%- assign s5 = 2 -%}{%- endif -%}
  {%- comment -%}Rich review text pools{%- endcomment -%}
  {%- assign rich_5_food_fr = "Produit vraiment excellent, conforme à ce qu'on trouve en épicerie turque à Paris. Livraison en 48h, emballage nickel. Je recommande sans hésiter !|Qualité top, exactement le même produit qu'en Turquie. Ma famille est ravie, on va recommander régulièrement.|Très bon produit, authentique et bien emballé. Le goût est parfait, rien à redire. Livraison rapide, 2 jours chrono.|Super qualité, rapport qualité-prix excellent. Je cherchais ce produit depuis longtemps à Paris, enfin trouvé !|Parfait ! Identique à ce que j'achetais au bled. Emballage soigné, bien protégé. Service client top." | split: "|" -%}
  {%- assign rich_4_food_fr = "Bon produit dans l'ensemble, qualité correcte. La livraison était un peu longue (4 jours) mais l'emballage était parfait. Je recommande.|Pas mal du tout. Le goût est bon, un poil différent de ce qu'on trouve en magasin local mais ça dépanne bien. Je repasserai commande.|Produit correct, rien à dire. Packaging soigné. Le prix est un peu élevé mais la qualité suit. 4 étoiles mérités." | split: "|" -%}
  {%- assign rich_3_food_fr = "Produit moyen honnêtement. Le goût n'est pas tout à fait celui que j'attendais. Livraison rapide par contre, c'est le point positif.|Bof. Pas mauvais mais pas exceptionnel non plus. J'ai connu mieux pour ce type de produit. Peut-être que mes attentes étaient trop élevées." | split: "|" -%}
  {%- assign rich_5_food_tr = "Ürün tam beklediğim gibi geldi, orijinal ambalajında. Paris'te bu ürünü bulmak çok zor oluyordu, artık buradan alıyorum. Kargo da çok hızlıydı, 2 günde geldi.|Harika bir ürün, tadı Türkiye'dekiyle birebir aynı. Ambalaj sağlam gelmişti, hiçbir hasar yoktu. Kesinlikle tekrar alacağım.|Mükemmel! Annem bu ürünü çok sevdi. Türkiye'de alınanla aynı kalite. Fiyat biraz yüksek ama kalitesine değiyor.|Çok iyi ürün, gayet memnun kaldım. Sipariş verdikten 3 gün sonra geldi, paket de sağlamdı. Herkese tavsiye ederim.|Ürün gerçekten kaliteli. Uzun süredir arıyordum, burada bulunca çok sevindim. Lezzeti de tam istediğim gibi." | split: "|" -%}
  {%- assign rich_4_food_tr = "İyi bir ürün, genel olarak memnunum. Kargo biraz gecikti ama sorun değil. Ürün ambalajı güzeldi, hasarsız geldi.|Fena değil, fiyatına göre iyi. Tadı biraz farklı ama idare eder. Bir sonraki siparişimde tekrar alırım muhtemelen.|Gayet iyi ürün. Beklediğimden biraz küçük geldi ama kalitesi güzeldi. Teşekkürler." | split: "|" -%}
  {%- assign rich_5_nf = "Ürün fotoğraflardakiyle birebir aynı çıktı. Ambalaj çok özenli, hiçbir çizik yok. Hediye olarak aldım, alıcı çok beğendi.|Qualité premium, exactement comme sur les photos. Livraison très soignée, emballé dans du papier bulle. Je suis très satisfait.|Sehr gutes Produkt, genau wie beschrieben. Schnelle Lieferung, gut verpackt. Sehr empfehlenswert!|Kalite çok iyi, sağlam yapılmış. Fotoğraflara bakarak sipariş ettim ve hayal kırıklığına uğramadım. Kesinlikle tavsiye ederim.|Produit de très bonne qualité, bien fini. Conforme à la description. Je l'ai offert en cadeau et il a beaucoup plu." | split: "|" -%}
  {%- assign rich_4_nf = "Bon produit, qualité correcte. Quelques petites différences avec les photos mais rien de grave. Dans l'ensemble je suis satisfait.|Produit correct pour le prix. La qualité aurait pu être meilleure à ce niveau de prix mais ça reste acceptable.|Ürün güzel ama fotoğraftaki kadar büyük değil. Renk de biraz farklı. Yine de kalitesi iyi, memnunum." | split: "|" -%}
  {%- comment -%}select rich text for each reviewer{%- endcomment -%}
  {%- assign ti2 = pid | plus: 11 | modulo: 5 -%}
  {%- assign ti3 = pid | plus: 22 | modulo: 5 -%}
  {%- assign ti4 = pid | plus: 33 | modulo: 3 -%}
  {%- assign ti5 = pid | plus: 44 | modulo: 2 -%}
  {%- assign bni2 = pid | plus: 2 | modulo: 3 -%}
  {%- assign bni3 = pid | plus: 3 | modulo: 2 -%}
  {%- assign is_tr2 = false -%}{%- if r2i < 50 -%}{%- assign is_tr2 = true -%}{%- endif -%}
  {%- assign is_tr3 = false -%}{%- if r3i < 50 -%}{%- assign is_tr3 = true -%}{%- endif -%}
  {%- assign total_revs = pid | modulo: 4 | plus: 3 -%}
  {%- assign avg_score = 4.8 -%}
  {%- if stars == 4 or s2 == 4 -%}{%- assign avg_score = 4.3 -%}{%- elsif stars <= 3 or s2 <= 3 -%}{%- assign avg_score = 3.8 -%}{%- endif -%}
  <div class="reviews-section" id="reviews-anchor">
    <div class="reviews-header-row">
      <div class="reviews-summary">
        <div class="reviews-big-score">
          <div class="score">{{ avg_score }}</div>
          <div class="score-stars">{% if avg_score >= 4.5 %}★★★★★{% elsif avg_score >= 4.0 %}★★★★☆{% else %}★★★☆☆{% endif %}</div>
          <div class="score-count">{{ total_revs }} avis vérifiés</div>
        </div>
      </div>
      <button class="write-review-btn" onclick="openReviewModal()">
        <svg viewBox="0 0 24 24" style="width:16px;height:16px;fill:#fff"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 000-1.41l-2.34-2.34a1 1 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
        Écrire un avis
      </button>
    </div>
    <div class="reviews-grid" id="reviews-container">

      {%- comment -%}── Review 1 ──{%- endcomment -%}
      <div class="review-card">
        <div class="review-card-header">
          <div class="review-avatar">{{ av1 }}{{ av2 }}</div>
          <div class="review-meta">
            <div class="review-name">{{ nm }} <span class="review-verified">✓ Vérifié</span></div>
            <div class="review-date">{{ dates[di] }}</div>
          </div>
          <div class="review-stars">{% if stars == 5 %}★★★★★{% elsif stars == 4 %}★★★★☆{% elsif stars == 3 %}★★★☆☆{% else %}★★☆☆☆{% endif %}</div>
        </div>
        <div class="review-text">
          {%- if is_nonfood -%}
            {%- if stars == 5 -%}{{ rich_5_nf[ti] }}{%- elsif stars == 4 -%}{{ rich_4_nf[ti | modulo: 3] }}{%- else -%}{{ b_nf[bni] }}{%- endif -%}
          {%- elsif is_tr -%}
            {%- if stars == 5 -%}{{ rich_5_food_tr[ti] }}{%- elsif stars == 4 -%}{{ rich_4_food_tr[ti | modulo: 3] }}{%- else -%}{{ b_tr[bni] }}{%- endif -%}
          {%- else -%}
            {%- if stars == 5 -%}{{ rich_5_food_fr[ti] }}{%- elsif stars == 4 -%}{{ rich_4_food_fr[ti | modulo: 3] }}{%- else -%}{{ rich_3_food_fr[bni | modulo: 2] }}{%- endif -%}
          {%- endif -%}
        </div>
      </div>

      {%- comment -%}── Review 2 ──{%- endcomment -%}
      <div class="review-card">
        <div class="review-card-header">
          <div class="review-avatar">{{ av2i1 }}{{ av2i2 }}</div>
          <div class="review-meta">
            <div class="review-name">{{ nm2 }} <span class="review-verified">✓ Vérifié</span></div>
            <div class="review-date">{{ dates[di | plus: 2 | modulo: 15] }}</div>
          </div>
          <div class="review-stars">{% if s2 == 5 %}★★★★★{% elsif s2 == 4 %}★★★★☆{% elsif s2 == 3 %}★★★☆☆{% else %}★★☆☆☆{% endif %}</div>
        </div>
        <div class="review-text">
          {%- if is_nonfood -%}
            {%- if s2 == 5 -%}{{ rich_5_nf[ti2] }}{%- elsif s2 == 4 -%}{{ rich_4_nf[bni2] }}{%- else -%}{{ b_nf[bni2] }}{%- endif -%}
          {%- elsif is_tr2 -%}
            {%- if s2 == 5 -%}{{ rich_5_food_tr[ti2] }}{%- elsif s2 == 4 -%}{{ rich_4_food_tr[bni2] }}{%- else -%}{{ b_tr[bni2] }}{%- endif -%}
          {%- else -%}
            {%- if s2 == 5 -%}{{ rich_5_food_fr[ti2] }}{%- elsif s2 == 4 -%}{{ rich_4_food_fr[bni2] }}{%- else -%}{{ rich_3_food_fr[0] }}{%- endif -%}
          {%- endif -%}
        </div>
      </div>

      {%- comment -%}── Review 3 ──{%- endcomment -%}
      <div class="review-card">
        <div class="review-card-header">
          <div class="review-avatar">{{ av3i1 }}{{ av3i2 }}</div>
          <div class="review-meta">
            <div class="review-name">{{ nm3 }} <span class="review-verified">✓ Vérifié</span></div>
            <div class="review-date">{{ dates[di | plus: 4 | modulo: 15] }}</div>
          </div>
          <div class="review-stars">{% if s3 == 5 %}★★★★★{% elsif s3 == 4 %}★★★★☆{% elsif s3 == 3 %}★★★☆☆{% else %}★★☆☆☆{% endif %}</div>
        </div>
        <div class="review-text">
          {%- if is_nonfood -%}
            {%- if s3 == 5 -%}{{ rich_5_nf[ti3] }}{%- elsif s3 == 4 -%}{{ rich_4_nf[0] }}{%- else -%}{{ b_nf[0] }}{%- endif -%}
          {%- elsif is_tr3 -%}
            {%- if s3 == 5 -%}{{ rich_5_food_tr[ti3] }}{%- elsif s3 == 4 -%}{{ rich_4_food_tr[0] }}{%- else -%}{{ b_tr[bni3] }}{%- endif -%}
          {%- else -%}
            {%- if s3 == 5 -%}{{ rich_5_food_fr[ti3] }}{%- elsif s3 == 4 -%}{{ rich_4_food_fr[0] }}{%- else -%}{{ rich_3_food_fr[1] }}{%- endif -%}
          {%- endif -%}
        </div>
      </div>

      {%- if total_revs >= 4 -%}
      {%- comment -%}── Review 4 ──{%- endcomment -%}
      <div class="review-card">
        <div class="review-card-header">
          <div class="review-avatar">{{ av4i1 }}{{ av4i2 }}</div>
          <div class="review-meta">
            <div class="review-name">{{ nm4 }} <span class="review-verified">✓ Vérifié</span></div>
            <div class="review-date">{{ dates[di | plus: 6 | modulo: 15] }}</div>
          </div>
          <div class="review-stars">{% if s4 == 5 %}★★★★★{% elsif s4 == 4 %}★★★★☆{% elsif s4 == 3 %}★★★☆☆{% else %}★★☆☆☆{% endif %}</div>
        </div>
        <div class="review-text">
          {%- if is_nonfood -%}
            {%- if s4 == 5 -%}{{ rich_5_nf[ti4] }}{%- else -%}{{ rich_4_nf[ti4] }}{%- endif -%}
          {%- else -%}
            {%- if s4 == 5 -%}{{ rich_5_food_fr[ti4 | modulo: 5] }}{%- else -%}{{ rich_4_food_fr[ti4] }}{%- endif -%}
          {%- endif -%}
        </div>
      </div>
      {%- endif -%}

      {%- if total_revs >= 5 -%}
      {%- comment -%}── Review 5 ──{%- endcomment -%}
      <div class="review-card">
        <div class="review-card-header">
          <div class="review-avatar">{{ av5i1 }}{{ av5i2 }}</div>
          <div class="review-meta">
            <div class="review-name">{{ nm5 }} <span class="review-verified">✓ Vérifié</span></div>
            <div class="review-date">{{ dates[di | plus: 8 | modulo: 15] }}</div>
          </div>
          <div class="review-stars">{% if s5 == 5 %}★★★★★{% elsif s5 == 4 %}★★★★☆{% elsif s5 == 3 %}★★★☆☆{% else %}★★☆☆☆{% endif %}</div>
        </div>
        <div class="review-text">
          {%- if is_nonfood -%}
            {%- if s5 == 5 -%}{{ rich_5_nf[ti5] }}{%- else -%}{{ rich_4_nf[0] }}{%- endif -%}
          {%- else -%}
            {%- if s5 == 5 -%}{{ rich_5_food_tr[ti5] }}{%- else -%}{{ rich_4_food_fr[1] }}{%- endif -%}
          {%- endif -%}
        </div>
      </div>
      {%- endif -%}

    </div>
  </div>
  {%- endunless -%}
  {%- endif -%}
