<div style="max-width:820px;margin:0 auto">

  <!-- Back -->
  <div style="padding:16px 20px 0">
    <a href="{{ blog.url }}" style="display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:#4A8C3F;text-decoration:none">
      ← {{ blog.title }}
    </a>
  </div>

  <!-- Hero image -->
  {% if article.image %}
    <div style="margin:16px 20px 0;border-radius:16px;overflow:hidden;aspect-ratio:16/9;position:relative">
      <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title }}" style="width:100%;height:100%;object-fit:cover">
    </div>
  {% endif %}

  <div style="padding:24px 20px 48px">

    <!-- Tags -->
    {% if article.tags.size > 0 %}
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px">
        {% for tag in article.tags limit: 4 %}
          <span style="font-size:10px;font-weight:700;color:#4A8C3F;background:#E8F2E3;padding:4px 12px;border-radius:20px;text-transform:uppercase;letter-spacing:.5px">{{ tag }}</span>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Title -->
    <h1 style="font-family:'Playfair Display',serif;font-size:28px;font-weight:700;color:#1C1C1C;line-height:1.25;margin-bottom:14px">
      {{ article.title }}
    </h1>

    <!-- Meta -->
    <div style="display:flex;align-items:center;gap:14px;font-size:13px;color:#aaa;margin-bottom:28px;padding-bottom:20px;border-bottom:1px solid #DDD8CC;flex-wrap:wrap">
      <span>✍️ {{ article.author }}</span>
      <span>📅 {{ article.published_at | date: '%d %B %Y' }}</span>
      {% if article.comments_count > 0 %}
        <span>💬 {{ article.comments_count }} commentaire{% if article.comments_count > 1 %}s{% endif %}</span>
      {% endif %}
    </div>

    <!-- Content -->
    <div style="font-size:16px;color:#4A4A4A;line-height:1.85" class="article-body">
      {{ article.content }}
    </div>

    <!-- Share -->
    <div style="margin-top:40px;padding-top:24px;border-top:1px solid #DDD8CC;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px">
      <div style="font-size:14px;font-weight:600;color:#1C1C1C">Partager cette recette</div>
      <div style="display:flex;gap:10px">
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ request.origin }}{{ article.url }}" target="_blank"
           style="width:40px;height:40px;background:#1877F2;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px">f</a>
        <a href="https://wa.me/?text={{ article.title | url_encode }}%20{{ request.origin }}{{ article.url | url_encode }}" target="_blank"
           style="width:40px;height:40px;background:#25D366;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px">💬</a>
      </div>
    </div>

    <!-- Back to blog -->
    <div style="margin-top:24px;text-align:center">
      <a href="{{ blog.url }}" style="display:inline-flex;align-items:center;gap:8px;background:#4A8C3F;color:#fff;padding:12px 24px;border-radius:10px;font-size:14px;font-weight:600;text-decoration:none">
        ← Toutes les recettes
      </a>
    </div>

  </div>
</div>

<style>
.article-body h1,.article-body h2,.article-body h3 { font-family:'Playfair Display',serif; color:#1C1C1C; margin:24px 0 12px; line-height:1.25; }
.article-body h2 { font-size:22px; }
.article-body h3 { font-size:18px; }
.article-body p { margin-bottom:16px; }
.article-body ul,.article-body ol { padding-left:22px; margin-bottom:16px; }
.article-body li { margin-bottom:6px; }
.article-body img { border-radius:12px; max-width:100%; height:auto; margin:20px 0; }
.article-body a { color:#4A8C3F; font-weight:600; }
.article-body blockquote { border-left:4px solid #4A8C3F; padding:14px 18px; background:#F8F4EC; border-radius:0 10px 10px 0; margin:20px 0; font-style:italic; color:#4A4A4A; }
.article-body strong { color:#1C1C1C; font-weight:700; }
</style>
