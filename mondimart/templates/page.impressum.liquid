.imp-rows { display: flex; flex-direction: column; }
.imp-row { display: flex; align-items: flex-start; gap: 16px; padding: 14px 24px; border-bottom: 1px solid var(--bo); }
.imp-row:last-child { border-bottom: none; }
.imp-row:nth-child(even) { background: var(--cr); }
.imp-row-label { font-size: 12px; font-weight: 700; color: var(--tl); text-transform: uppercase; letter-spacing: .5px; width: 180px; flex-shrink: 0; padding-top: 1px; }
.imp-row-val { font-size: 14px; color: var(--td); font-weight: 500; flex: 1; }
.imp-row-val strong { font-weight: 700; color: var(--td); }
.imp-badge-ok { display: inline-flex; align-items: center; gap: 5px; background: #E8F5E3; color: #2D6A2D; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 12px; }
.imp-badge-no { display: inline-flex; align-items: center; gap: 5px; background: #F5F5F5; color: #888; font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 12px; }
.imp-mono { font-family: 'Courier New', monospace; font-size: 14px; font-weight: 700; color: var(--gd); letter-spacing: .5px; }

/* CONTACT CARD */
.imp-contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.imp-contact-item { background: #fff; border: 1px solid var(--bo); border-radius: 12px; padding: 18px 20px; display: flex; gap: 14px; align-items: flex-start; transition: box-shadow .2s; }
.imp-contact-item:hover { box-shadow: 0 4px 16px rgba(0,0,0,.07); }
.imp-contact-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.imp-contact-icon svg { width: 20px; height: 20px; }
.imp-contact-lbl { font-size: 11px; font-weight: 700; color: var(--tl); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 4px; }
.imp-contact-val { font-size: 14px; font-weight: 600; color: var(--td); }
.imp-contact-val a { color: var(--gl); text-decoration: none; }
.imp-contact-val a:hover { text-decoration: underline; }

/* LEGAL TEXT */
.imp-text { font-size: 14px; color: var(--tm); line-height: 1.8; }
.imp-text p { margin-bottom: 12px; }
.imp-text p:last-child { margin-bottom: 0; }

/* HOST CARD */
.imp-host { background: var(--cr); border: 1px solid var(--bo); border-radius: 12px; padding: 20px 24px; display: flex; gap: 16px; align-items: center; }
.imp-host-logo { width: 48px; height: 48px; background: #fff; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid var(--bo); font-weight: 800; font-size: 13px; color: var(--gd); }
.imp-host-info h4 { font-size: 15px; font-weight: 700; color: var(--td); margin-bottom: 3px; }
.imp-host-info p { font-size: 13px; color: var(--tl); line-height: 1.5; }

@media(max-width: 640px) {
  .imp-hero h1 { font-size: 28px; }
  .imp-row { flex-direction: column; gap: 4px; }
  .imp-row-label { width: auto; }
  .imp-contact-grid { grid-template-columns: 1fr; }
  .imp-page { padding: 32px 16px 60px; }
