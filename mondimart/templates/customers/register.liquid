<style>
.auth-page { min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 40px 16px; background: var(--cr); }
.auth-card { background: #fff; border-radius: 20px; padding: 44px 40px; width: 100%; max-width: 460px; box-shadow: 0 8px 48px rgba(0,0,0,.1); }
.auth-logo { text-align: center; margin-bottom: 28px; }
.auth-logo-icon { width: 52px; height: 52px; background: var(--gd); border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px; }
.auth-logo-icon svg { width: 28px; height: 28px; fill: #fff; }
.auth-title { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: var(--td); margin-bottom: 6px; }
.auth-sub { font-size: 14px; color: var(--tl); }
.auth-error { background: #FDE8E8; color: #C0392B; padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; font-size: 13px; border: 1px solid #F5C6C6; }
.auth-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.auth-field { margin-bottom: 16px; }
.auth-label { display: block; font-size: 13px; font-weight: 600; color: var(--tm); margin-bottom: 7px; }
.auth-input-wrap { position: relative; }
.auth-input { width: 100%; height: 48px; padding: 0 46px 0 16px; border: 1.5px solid var(--bo); border-radius: 10px; font-family: 'DM Sans', sans-serif; font-size: 14px; color: var(--td); outline: none; transition: border-color .2s, box-shadow .2s; background: #fff; }
.auth-input:focus { border-color: var(--gl); box-shadow: 0 0 0 3px rgba(74,140,63,.1); }
.auth-input.error { border-color: #C0392B; }
.auth-input-icon { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; fill: var(--tl); pointer-events: none; }
.auth-eye { pointer-events: all !important; cursor: pointer; }
.auth-strength { height: 3px; border-radius: 2px; margin-top: 6px; background: var(--bo); overflow: hidden; }
.auth-strength-bar { height: 100%; border-radius: 2px; width: 0; transition: width .3s, background .3s; }
.auth-strength-text { font-size: 11px; color: var(--tl); margin-top: 4px; }
.auth-submit { width: 100%; height: 50px; background: var(--gd); color: #fff; border: none; border-radius: 12px; font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 700; cursor: pointer; transition: background .2s, transform .1s; margin-top: 8px; letter-spacing: .3px; }
.auth-submit:hover { background: var(--gm); }
.auth-submit:active { transform: scale(.99); }
.auth-terms { font-size: 12px; color: var(--tl); text-align: center; margin-top: 14px; line-height: 1.6; }
.auth-terms a { color: var(--gl); }
.auth-divider { display: flex; align-items: center; gap: 12px; margin: 20px 0; color: var(--tl); font-size: 12px; }
.auth-divider::before, .auth-divider::after { content: ''; flex: 1; height: 1px; background: var(--bo); }
.auth-links { text-align: center; font-size: 13px; color: var(--tl); }
.auth-links a { color: var(--gl); font-weight: 600; }
.auth-perks { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 24px; }
.auth-perk { flex: 1; min-width: 120px; display: flex; align-items: center; gap: 7px; background: var(--cr); border-radius: 10px; padding: 10px 12px; font-size: 12px; color: var(--tm); font-weight: 500; }
.auth-perk span { font-size: 16px; }
.auth-trust { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 18px; font-size: 11px; color: var(--tl); }
.auth-trust svg { width: 13px; height: 13px; fill: var(--gl); }

@media(max-width:480px) {
  .auth-card { padding: 28px 18px; border-radius: 16px; }
  .auth-title { font-size: 22px; }
  .auth-row { grid-template-columns: 1fr; gap: 0; }
}
</style>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <div class="auth-logo-icon">
        <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
      </div>
      <div class="auth-title">Créer un compte</div>
      <div class="auth-sub">Rejoignez la communauté Mondimart</div>
    </div>

    <div class="auth-perks">
      <div class="auth-perk"><span>🚚</span> Livraison gratuite dès 49€</div>
      <div class="auth-perk"><span>🎁</span> Offres exclusives membres</div>
      <div class="auth-perk"><span>📦</span> Suivi de commandes</div>
    </div>

    {% form 'create_customer' %}
      {% if form.errors %}
        <div class="auth-error">{{ form.errors | default_errors }}</div>
      {% endif %}

      <div class="auth-row">
        <div class="auth-field">
          <label class="auth-label" for="reg-first">Prénom</label>
          <div class="auth-input-wrap">
            <input class="auth-input" type="text" name="customer[first_name]" id="reg-first" autocomplete="given-name" placeholder="Marie" required>
            <svg class="auth-input-icon" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
          </div>
        </div>
        <div class="auth-field">
          <label class="auth-label" for="reg-last">Nom</label>
          <div class="auth-input-wrap">
            <input class="auth-input" type="text" name="customer[last_name]" id="reg-last" autocomplete="family-name" placeholder="Dupont" required>
            <svg class="auth-input-icon" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
          </div>
        </div>
      </div>

      <div class="auth-field">
        <label class="auth-label" for="reg-email">Adresse email</label>
        <div class="auth-input-wrap">
          <input class="auth-input" type="email" name="customer[email]" id="reg-email" autocomplete="email" placeholder="votre@email.com" required>
          <svg class="auth-input-icon" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        </div>
      </div>

      <div class="auth-field">
        <label class="auth-label" for="reg-password">Mot de passe</label>
        <div class="auth-input-wrap">
          <input class="auth-input" type="password" name="customer[password]" id="reg-password" autocomplete="new-password" placeholder="Min. 8 caractères" required oninput="checkStrength(this.value)">
          <svg class="auth-input-icon auth-eye" viewBox="0 0 24 24" onclick="togglePwd('reg-password',this)"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
        </div>
        <div class="auth-strength"><div class="auth-strength-bar" id="strength-bar"></div></div>
        <div class="auth-strength-text" id="strength-text"></div>
      </div>

      <div class="auth-field">
        <label class="auth-label" for="reg-password2">Confirmer le mot de passe</label>
        <div class="auth-input-wrap">
          <input class="auth-input" type="password" id="reg-password2" autocomplete="new-password" placeholder="Répétez le mot de passe" required oninput="checkMatch()">
          <svg class="auth-input-icon auth-eye" viewBox="0 0 24 24" onclick="togglePwd('reg-password2',this)"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
        </div>
        <div class="auth-strength-text" id="match-text"></div>
      </div>

      <button type="submit" class="auth-submit" id="reg-submit">Créer mon compte →</button>

      <p class="auth-terms">
        En créant un compte, vous acceptez nos <a href="/policies/terms-of-service">CGV</a> et notre <a href="/policies/privacy-policy">Politique de confidentialité</a>.
      </p>
    {% endform %}

    <div class="auth-divider">ou</div>
    <div class="auth-links">
      Déjà inscrit ? <a href="/account/login">Se connecter</a>
    </div>

    <div class="auth-trust">
      <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
      Inscription 100% sécurisée
    </div>
  </div>
</div>

<script>
function togglePwd(id, icon) {
  var inp = document.getElementById(id);
  if (inp.type === 'password') { inp.type = 'text'; icon.style.fill = 'var(--gl)'; }
  else { inp.type = 'password'; icon.style.fill = 'var(--tl)'; }
}

function checkStrength(val) {
  var bar = document.getElementById('strength-bar');
  var txt = document.getElementById('strength-text');
  var score = 0;
  if (val.length >= 8) score++;
  if (/[A-Z]/.test(val)) score++;
  if (/[0-9]/.test(val)) score++;
  if (/[^A-Za-z0-9]/.test(val)) score++;
  var colors = ['#C0392B','#E67E22','#F1C40F','#27AE60'];
  var labels = ['Très faible','Faible','Moyen','Fort'];
  if (val.length === 0) { bar.style.width = '0'; txt.textContent = ''; return; }
  bar.style.width = (score * 25) + '%';
  bar.style.background = colors[score - 1] || colors[0];
  txt.textContent = labels[score - 1] || labels[0];
  txt.style.color = colors[score - 1] || colors[0];
}

function checkMatch() {
  var p1 = document.getElementById('reg-password').value;
  var p2 = document.getElementById('reg-password2').value;
  var txt = document.getElementById('match-text');
  if (!p2) { txt.textContent = ''; return; }
  if (p1 === p2) { txt.textContent = '✓ Les mots de passe correspondent'; txt.style.color = '#27AE60'; }
  else { txt.textContent = '✗ Les mots de passe ne correspondent pas'; txt.style.color = '#C0392B'; }
}

document.getElementById('reg-submit').addEventListener('click', function(e) {
  var p1 = document.getElementById('reg-password').value;
  var p2 = document.getElementById('reg-password2').value;
  if (p1 !== p2) {
    e.preventDefault();
    document.getElementById('reg-password2').classList.add('error');
    document.getElementById('match-text').textContent = '✗ Les mots de passe ne correspondent pas';
    document.getElementById('match-text').style.color = '#C0392B';
  }
});
</script>
