<style>
.acc-page { max-width: 1000px; margin: 0 auto; padding: 40px 24px 80px; }

/* HEADER */
.acc-header { background: linear-gradient(135deg, var(--gd), #1A4A2D); border-radius: 20px; padding: 32px 28px; display: flex; align-items: center; gap: 20px; margin-bottom: 32px; }
.acc-avatar { width: 64px; height: 64px; background: rgba(255,255,255,.15); border-radius: 50%; border: 3px solid rgba(168,216,160,.4); display: flex; align-items: center; justify-content: center; font-family: 'Playfair Display', serif; font-size: 26px; font-weight: 700; color: #fff; flex-shrink: 0; }
.acc-info h1 { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: #fff; margin-bottom: 4px; }
.acc-info p { font-size: 13px; color: rgba(255,255,255,.65); }
.acc-header-actions { margin-left: auto; display: flex; gap: 10px; flex-shrink: 0; }
.acc-logout { display: inline-flex; align-items: center; gap: 6px; padding: 10px 16px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.2); border-radius: 10px; color: rgba(255,255,255,.85); font-size: 13px; font-weight: 600; text-decoration: none; transition: background .2s; }
.acc-logout:hover { background: rgba(255,255,255,.2); }

/* STATS */
.acc-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; margin-bottom: 32px; }
.acc-stat { background: #fff; border: 1px solid var(--bo); border-radius: 14px; padding: 20px 18px; text-align: center; }
.acc-stat-val { font-family: 'Playfair Display', serif; font-size: 26px; font-weight: 700; color: var(--td); margin-bottom: 4px; }
.acc-stat-lbl { font-size: 12px; color: var(--tl); }

/* TABS */
.acc-tabs { display: flex; gap: 4px; border-bottom: 2px solid var(--bo); margin-bottom: 28px; overflow-x: auto; scrollbar-width: none; }
.acc-tabs::-webkit-scrollbar { display: none; }
.acc-tab { padding: 11px 20px; font-size: 13px; font-weight: 600; color: var(--tl); border: none; background: none; cursor: pointer; white-space: nowrap; border-bottom: 2px solid transparent; margin-bottom: -2px; transition: all .2s; }
.acc-tab:hover { color: var(--td); }
.acc-tab.active { color: var(--gd); border-bottom-color: var(--gl); }

.acc-panel { display: none; }
.acc-panel.active { display: block; }

/* ORDERS */
.acc-order { background: #fff; border: 1px solid var(--bo); border-radius: 14px; overflow: hidden; margin-bottom: 14px; transition: box-shadow .2s; }
.acc-order:hover { box-shadow: 0 4px 16px rgba(0,0,0,.08); }
.acc-order-head { display: flex; align-items: center; gap: 14px; padding: 16px 20px; border-bottom: 1px solid var(--bo); flex-wrap: wrap; gap: 10px; }
.acc-order-num { font-size: 14px; font-weight: 700; color: var(--td); }
.acc-order-date { font-size: 12px; color: var(--tl); }
.acc-order-status { display: inline-flex; align-items: center; gap: 5px; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; }
.acc-order-total { font-size: 15px; font-weight: 700; color: var(--td); margin-left: auto; }
.acc-order-link { font-size: 12px; color: var(--gl); font-weight: 600; text-decoration: none; padding: 6px 14px; border: 1px solid var(--gl); border-radius: 8px; transition: all .2s; }
.acc-order-link:hover { background: var(--gl); color: #fff; }
.acc-order-items { padding: 14px 20px; display: flex; gap: 10px; overflow-x: auto; scrollbar-width: none; }
.acc-order-items::-webkit-scrollbar { display: none; }
.acc-order-thumb { width: 56px; height: 56px; border-radius: 8px; border: 1px solid var(--bo); overflow: hidden; flex-shrink: 0; background: var(--cr); }
.acc-order-thumb img { width: 100%; height: 100%; object-fit: cover; }

/* ADDRESSES */
.acc-addresses { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px,1fr)); gap: 14px; }
.acc-address { background: #fff; border: 1px solid var(--bo); border-radius: 14px; padding: 20px; position: relative; }
.acc-address.default { border-color: var(--gl); background: #F0F7EE; }
.acc-address-badge { position: absolute; top: 12px; right: 12px; font-size: 10px; font-weight: 700; background: var(--gl); color: #fff; padding: 3px 10px; border-radius: 20px; }
.acc-address h4 { font-size: 14px; font-weight: 700; color: var(--td); margin-bottom: 8px; }
.acc-address p { font-size: 13px; color: var(--tm); line-height: 1.6; }
.acc-address-actions { display: flex; gap: 8px; margin-top: 14px; }
.acc-address-btn { font-size: 12px; font-weight: 600; padding: 6px 12px; border-radius: 8px; border: 1px solid var(--bo); background: #fff; cursor: pointer; color: var(--tm); text-decoration: none; transition: all .2s; }
.acc-address-btn:hover { border-color: var(--gl); color: var(--gl); }
.acc-address-btn.danger:hover { border-color: var(--rp); color: var(--rp); }

/* EMPTY */
.acc-empty { text-align: center; padding: 56px 20px; background: var(--cr); border-radius: 16px; }
.acc-empty-icon { font-size: 52px; margin-bottom: 14px; }
.acc-empty h3 { font-family: 'Playfair Display', serif; font-size: 20px; color: var(--td); margin-bottom: 8px; }
.acc-empty p { font-size: 14px; color: var(--tl); margin-bottom: 20px; }
.acc-empty a { display: inline-flex; background: var(--gl); color: #fff; padding: 12px 24px; border-radius: 10px; font-size: 14px; font-weight: 600; text-decoration: none; }

/* PROFILE FORM */
.acc-form { background: #fff; border: 1px solid var(--bo); border-radius: 16px; padding: 28px; }
.acc-form h3 { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700; color: var(--td); margin-bottom: 22px; }
.acc-field { margin-bottom: 18px; }
.acc-label { display: block; font-size: 13px; font-weight: 600; color: var(--tm); margin-bottom: 7px; }
.acc-input { width: 100%; height: 46px; padding: 0 14px; border: 1.5px solid var(--bo); border-radius: 10px; font-family: 'DM Sans', sans-serif; font-size: 14px; outline: none; transition: border-color .2s; }
.acc-input:focus { border-color: var(--gl); }
.acc-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.acc-submit { height: 46px; padding: 0 28px; background: var(--gd); color: #fff; border: none; border-radius: 10px; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 700; cursor: pointer; transition: background .2s; }
.acc-submit:hover { background: var(--gm); }

@media(max-width: 640px) {
  .acc-header { flex-wrap: wrap; gap: 14px; }
  .acc-header-actions { margin-left: 0; }
  .acc-stats { grid-template-columns: 1fr 1fr 1fr; }
  .acc-stat-val { font-size: 20px; }
  .acc-grid-2 { grid-template-columns: 1fr; }
  .acc-page { padding: 24px 14px 60px; }
}
</style>

<div class="acc-page">

  <!-- HEADER -->
  <div class="acc-header">
    <div class="acc-avatar">{{ customer.first_name | slice: 0 | upcase }}</div>
    <div class="acc-info">
      <h1>Bonjour, {{ customer.first_name }} !</h1>
      <p>{{ customer.email }}</p>
    </div>
    <div class="acc-header-actions">
      <a href="/account/logout" class="acc-logout">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="rgba(255,255,255,.85)"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
        Déconnexion
      </a>
    </div>
  </div>

  <!-- STATS -->
  <div class="acc-stats">
    <div class="acc-stat">
      <div class="acc-stat-val">{{ customer.orders.size }}</div>
      <div class="acc-stat-lbl">Commandes</div>
    </div>
    <div class="acc-stat">
      <div class="acc-stat-val">{{ customer.addresses.size }}</div>
      <div class="acc-stat-lbl">Adresses</div>
    </div>
    <div class="acc-stat">
      <div class="acc-stat-val">
        {% if customer.orders.size > 0 %}
          {{ customer.orders | map: 'total_price' | sum | money }}
        {% else %}
          —
        {% endif %}
      </div>
      <div class="acc-stat-lbl">Total dépensé</div>
    </div>
  </div>

  <!-- TABS -->
  <div class="acc-tabs">
    <button class="acc-tab active" onclick="accTab(this,'orders')">📦 Mes commandes</button>
    <button class="acc-tab" onclick="accTab(this,'addresses')">📍 Mes adresses</button>
    <button class="acc-tab" onclick="accTab(this,'profile')">👤 Mon profil</button>
  </div>

  <!-- ORDERS PANEL -->
  <div class="acc-panel active" id="acc-panel-orders">
    {% if customer.orders.size == 0 %}
      <div class="acc-empty">
        <div class="acc-empty-icon">📦</div>
        <h3>Aucune commande pour le moment</h3>
        <p>Découvrez notre sélection de produits du monde entier et passez votre première commande.</p>
        <a href="/collections/all">Explorer nos produits →</a>
      </div>
    {% else %}
      {% for order in customer.orders %}
        <div class="acc-order">
          <div class="acc-order-head">
            <div>
              <div class="acc-order-num">{{ order.name }}</div>
              <div class="acc-order-date">{{ order.created_at | date: '%d %B %Y' }}</div>
            </div>
            {% case order.financial_status %}
              {% when 'paid' %}
                <span class="acc-order-status" style="background:#E8F5E3;color:#2D6A2D">✓ Payée</span>
              {% when 'pending' %}
                <span class="acc-order-status" style="background:#FEF9E7;color:#B8860B">⏳ En attente</span>
              {% when 'refunded' %}
                <span class="acc-order-status" style="background:#FDEDEC;color:#A93226">↩ Remboursée</span>
              {% else %}
                <span class="acc-order-status" style="background:#F5F5F5;color:#888">{{ order.financial_status_label }}</span>
            {% endcase %}
            {% case order.fulfillment_status %}
              {% when 'fulfilled' %}
                <span class="acc-order-status" style="background:#EAF4FB;color:#1A5276">🚚 Expédiée</span>
              {% when 'partial' %}
                <span class="acc-order-status" style="background:#FEF9E7;color:#B8860B">📦 Partielle</span>
            {% endcase %}
            <div class="acc-order-total">{{ order.total_price | money }}</div>
            <a href="{{ order.customer_url }}" class="acc-order-link">Détails →</a>
          </div>
          {% if order.line_items.size > 0 %}
            <div class="acc-order-items">
              {% for item in order.line_items limit: 6 %}
                <div class="acc-order-thumb" title="{{ item.title }}">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 112 }}" alt="{{ item.title }}" loading="lazy">
                  {% else %}
                    <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:22px;background:var(--cr)">🛒</div>
                  {% endif %}
                </div>
              {% endfor %}
              {% if order.line_items.size > 6 %}
                <div class="acc-order-thumb" style="display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:var(--tl);background:var(--cr)">+{{ order.line_items.size | minus: 6 }}</div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}
  </div>

  <!-- ADDRESSES PANEL -->
  <div class="acc-panel" id="acc-panel-addresses">
    {% if customer.addresses.size == 0 %}
      <div class="acc-empty">
        <div class="acc-empty-icon">📍</div>
        <h3>Aucune adresse enregistrée</h3>
        <p>Ajoutez une adresse de livraison pour accélérer vos prochaines commandes.</p>
        <a href="/account/addresses/new">Ajouter une adresse</a>
      </div>
    {% else %}
      <div class="acc-addresses">
        {% for address in customer.addresses %}
          <div class="acc-address {% if address == customer.default_address %}default{% endif %}">
            {% if address == customer.default_address %}
              <span class="acc-address-badge">Par défaut</span>
            {% endif %}
            <h4>{{ address.first_name }} {{ address.last_name }}</h4>
            <p>
              {{ address.address1 }}<br>
              {% if address.address2 != blank %}{{ address.address2 }}<br>{% endif %}
              {{ address.zip }} {{ address.city }}<br>
              {{ address.country }}
            </p>
            <div class="acc-address-actions">
              <a href="/account/addresses/{{ address.id }}" class="acc-address-btn">Modifier</a>
              {% form 'customer_address', address %}
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="acc-address-btn danger" onclick="return confirm('Supprimer cette adresse ?')">Supprimer</button>
              {% endform %}
            </div>
          </div>
        {% endfor %}
        <a href="/account/addresses/new" style="display:flex;align-items:center;justify-content:center;gap:10px;background:var(--cr);border:2px dashed var(--bo);border-radius:14px;padding:20px;font-size:14px;font-weight:600;color:var(--tl);text-decoration:none;min-height:100px;transition:all .2s">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
          Ajouter une adresse
        </a>
      </div>
    {% endif %}
  </div>

  <!-- PROFILE PANEL -->
  <div class="acc-panel" id="acc-panel-profile">
    {% form 'customer' %}
      <div class="acc-form">
        <h3>Informations personnelles</h3>
        {% if form.errors %}
          <div style="background:#FDEDEC;color:#A93226;padding:12px 16px;border-radius:10px;margin-bottom:20px;font-size:13px;border:1px solid #F5C6C6">{{ form.errors | default_errors }}</div>
        {% endif %}
        <div class="acc-grid-2">
          <div class="acc-field">
            <label class="acc-label">Prénom</label>
            <input class="acc-input" type="text" name="customer[first_name]" value="{{ customer.first_name }}" autocomplete="given-name">
          </div>
          <div class="acc-field">
            <label class="acc-label">Nom</label>
            <input class="acc-input" type="text" name="customer[last_name]" value="{{ customer.last_name }}" autocomplete="family-name">
          </div>
        </div>
        <div class="acc-field">
          <label class="acc-label">Adresse email</label>
          <input class="acc-input" type="email" name="customer[email]" value="{{ customer.email }}" autocomplete="email">
        </div>
        <div class="acc-field">
          <label class="acc-label">Téléphone</label>
          <input class="acc-input" type="tel" name="customer[phone]" value="{{ customer.phone }}" placeholder="+33 6 00 00 00 00" autocomplete="tel">
        </div>
      </div>

      <div class="acc-form" style="margin-top:16px">
        <h3>Changer le mot de passe</h3>
        <div class="acc-grid-2">
          <div class="acc-field">
            <label class="acc-label">Nouveau mot de passe</label>
            <input class="acc-input" type="password" name="customer[password]" autocomplete="new-password" placeholder="Laisser vide pour ne pas changer">
          </div>
          <div class="acc-field">
            <label class="acc-label">Confirmer le mot de passe</label>
            <input class="acc-input" type="password" name="customer[password_confirmation]" autocomplete="new-password" placeholder="Confirmer le nouveau mot de passe">
          </div>
        </div>
        <button type="submit" class="acc-submit">Enregistrer les modifications</button>
      </div>
    {% endform %}
  </div>

</div>

<script>
function accTab(btn, panel) {
  document.querySelectorAll('.acc-tab').forEach(function(b) { b.classList.remove('active'); });
  document.querySelectorAll('.acc-panel').forEach(function(p) { p.classList.remove('active'); });
  btn.classList.add('active');
  document.getElementById('acc-panel-' + panel).classList.add('active');
}
</script>
