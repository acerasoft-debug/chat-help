<script>
(function() {
  var track = document.getElementById('pcarousel');
  var btnPrev = document.getElementById('pcar-prev');
  var btnNext = document.getElementById('pcar-next');
  if (!track) return;
  var cardW = function() {
    var c = track.querySelector('.pcar-item');
    return c ? c.offsetWidth + parseInt(getComputedStyle(track).gap || 16) : 220;
  };
  if (btnPrev) btnPrev.addEventListener('click', function() {
    track.scrollBy({ left: -cardW() * 2, behavior: 'smooth' });
  });
  if (btnNext) btnNext.addEventListener('click', function() {
    track.scrollBy({ left: cardW() * 2, behavior: 'smooth' });
  });
  /* Auto-scroll every 3.5s */
  var autoTimer = setInterval(function() {
    var maxScroll = track.scrollWidth - track.clientWidth;
    if (track.scrollLeft >= maxScroll - 10) {
      track.scrollTo({ left: 0, behavior: 'smooth' });
    } else {
      track.scrollBy({ left: cardW(), behavior: 'smooth' });
    }
  }, 3500);
  /* Pause on hover/touch */
  track.addEventListener('mouseenter', function() { clearInterval(autoTimer); });
  track.addEventListener('touchstart', function() { clearInterval(autoTimer); }, { passive: true });
})();
</script>


