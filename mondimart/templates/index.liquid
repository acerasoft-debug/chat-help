<script>
(function() {
  var track = document.getElementById('kcarousel');
  var btnP  = document.getElementById('kcar-prev');
  var btnN  = document.getElementById('kcar-next');
  if (!track) return;
  var cw = function() {
    var c = track.querySelector('.pcar-item');
    return c ? c.offsetWidth + 16 : 220;
  };
  if (btnP) btnP.addEventListener('click', function() { track.scrollBy({ left: -cw()*2, behavior:'smooth' }); });
  if (btnN) btnN.addEventListener('click', function() { track.scrollBy({ left:  cw()*2, behavior:'smooth' }); });
  var t = setInterval(function() {
    var max = track.scrollWidth - track.clientWidth;
    if (track.scrollLeft >= max - 10) { track.scrollTo({ left:0, behavior:'smooth' }); }
    else { track.scrollBy({ left: cw(), behavior:'smooth' }); }
  }, 3000);
  track.addEventListener('mouseenter', function() { clearInterval(t); });
  track.addEventListener('touchstart', function() { clearInterval(t); }, { passive:true });
})();
</script>
