<script>
(function() {
  var slides = [
    { label: "Épices du monde",         href: "/collections/epices" },
    { label: "Fruits & légumes",        href: "/collections/epicerie-fine" },
    { label: "Épicerie mondiale",       href: "/collections/all" },
    { label: "Cuisine méditerranéenne", href: "/collections/epicerie-fine" },
    { label: "Huile d'olive",           href: "/search?q=olive" },
    { label: "Saveurs du monde",        href: "/collections/all" },
    { label: "Baklava & pâtisseries",   href: "/search?q=baklava" },
    { label: "Karaca — Vaisselle",      href: "/collections/karaca" },
    { label: "Karaca — Arts de table",  href: "/collections/karaca" },
    { label: "Karaca — Cuisine",        href: "/collections/karaca" }
  ];
  var CYCLE = 30000, PER = 3000;
  var startTime = Date.now(); /* anchor to page load so JS matches CSS animation */
  var link  = document.getElementById('hero-slide-link');
  var label = document.getElementById('hero-slide-label');
  if (!link || !label) return;
  function update() {
    var elapsed = (Date.now() - startTime) % CYCLE;
    var idx = Math.floor(elapsed / PER) % slides.length;
    link.href  = slides[idx].href;
    label.textContent = slides[idx].label;
  }
  update();
  setInterval(update, PER);
})();
</script>

