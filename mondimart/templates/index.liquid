<section class="section recipes-section">
  <div class="section-inner">
    <div class="section-header">
      <div><h2 class="section-title">Recettes du <span>Monde Entier</span></h2><p class="section-sub">Cuisinez avec nos produits — recettes authentiques</p></div>
      <a class="see-all" href="/blogs/recettes">Toutes les recettes <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg></a>
    </div>
    {% assign rec_blog = blogs['recettes'] %}
    {% if rec_blog.articles.size > 0 %}
      <div class="recipes-grid">
        {% for article in rec_blog.articles limit: 3 %}
          <a class="recipe-card" href="{{ article.url }}">
            <div class="recipe-img">{% if article.image %}<img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title }}" loading="lazy">{% else %}<img src="https://images.unsplash.com/photo-1490474418585-ba9bad8fd0ea?w=800&q=80" alt="{{ article.title }}" loading="lazy">{% endif %}<span class="recipe-tag">{% if forloop.first %}Recette phare{% else %}Populaire{% endif %}</span></div>
            <div class="recipe-info"><div class="recipe-cuisine">{{ article.tags | first }}</div><div class="recipe-title">{{ article.title }}</div><div class="recipe-meta"><span>{{ article.published_at | date: '%d %b %Y' }}</span></div></div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="recipes-grid">
        <a class="recipe-card" href="/blogs/recettes"><div class="recipe-img"><img src="https://images.unsplash.com/photo-1490474418585-ba9bad8fd0ea?w=800&q=80" alt="Baklava" loading="lazy"><span class="recipe-tag">Recette phare</span></div><div class="recipe-info"><div class="recipe-cuisine">🇹🇷 Cuisine Turque</div><div class="recipe-title">Baklava Maison aux Pistaches</div><div class="recipe-meta"><span>90 min</span><span>8 pers.</span></div></div></a>
        <a class="recipe-card" href="/blogs/recettes"><div class="recipe-img"><img src="https://images.unsplash.com/photo-1574484284002-952d92456975?w=500&q=80" alt="Bœuf Bourguignon" loading="lazy"><span class="recipe-tag">Populaire</span></div><div class="recipe-info"><div class="recipe-cuisine">🇫🇷 Cuisine Française</div><div class="recipe-title">Bœuf Bourguignon Traditionnel</div><div class="recipe-meta"><span>3h</span><span>6 pers.</span></div></div></a>
        <a class="recipe-card" href="/blogs/recettes"><div class="recipe-img"><img src="https://images.unsplash.com/photo-1598514982901-5c1d2d10562b?w=500&q=80" alt="Carbonara" loading="lazy"><span class="recipe-tag">Facile</span></div><div class="recipe-info"><div class="recipe-cuisine">🇮🇹 Cuisine Italienne</div><div class="recipe-title">Spaghetti Carbonara Authentique</div><div class="recipe-meta"><span>25 min</span><span>2 pers.</span></div></div></a>
      </div>
    {% endif %}
  </div>
</section>

