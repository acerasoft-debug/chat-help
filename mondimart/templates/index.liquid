<script>
// Countdown
(function(){
  var s=17,m=42,h=6;
  setInterval(function(){
    s--;if(s<0){s=59;m--;}if(m<0){m=59;h--;}if(h<0){h=0;m=0;s=0;}
    var ch=document.getElementById('cd-h'),cm=document.getElementById('cd-m'),cs=document.getElementById('cd-s');
    if(ch)ch.textContent=String(h).padStart(2,'0');
    if(cm)cm.textContent=String(m).padStart(2,'0');
    if(cs)cs.textContent=String(s).padStart(2,'0');
  },1000);
})();
// Filter tabs
function filterTab(el){document.querySelectorAll('.filter-tab').forEach(function(t){t.classList.remove('active');});el.classList.add('active');}
</script>
