<style>
.dlv-page { max-width: 980px; margin: 0 auto; padding: 52px 24px 80px; }

/* HERO */
.dlv-hero { text-align: center; margin-bottom: 56px; }
.dlv-hero-badge { display: inline-flex; align-items: center; gap: 8px; background: #E8F5E3; color: #2D6A2D; font-size: 12px; font-weight: 700; padding: 6px 16px; border-radius: 20px; margin-bottom: 18px; letter-spacing: .5px; text-transform: uppercase; }
.dlv-hero h1 { font-family: 'Playfair Display', serif; font-size: 42px; font-weight: 700; color: var(--td); margin-bottom: 14px; line-height: 1.2; }
.dlv-hero p { font-size: 16px; color: var(--tl); max-width: 580px; margin: 0 auto; line-height: 1.75; }

/* STATS BAR */
.dlv-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 56px; }
.dlv-stat { background: #fff; border: 1px solid var(--bo); border-radius: 16px; padding: 24px 16px; text-align: center; transition: box-shadow .2s; }
.dlv-stat:hover { box-shadow: 0 4px 20px rgba(0,0,0,.08); }
.dlv-stat-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; }
.dlv-stat-icon svg { width: 26px; height: 26px; }
.dlv-stat-val { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: var(--td); margin-bottom: 4px; }
.dlv-stat-lbl { font-size: 12px; color: var(--tl); line-height: 1.4; }

/* SECTION TITLES */
.dlv-section { margin-bottom: 48px; }
.dlv-section-head { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; }
.dlv-section-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.dlv-section-icon svg { width: 22px; height: 22px; }
.dlv-section-head h2 { font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 700; color: var(--td); }
.dlv-section-head p { font-size: 13px; color: var(--tl); margin-top: 2px; }

/* DELIVERY CARDS */
.dlv-cards { display: grid; gap: 16px; }
.dlv-card { border-radius: 16px; overflow: hidden; display: flex; border: 1px solid var(--bo); transition: box-shadow .2s, transform .2s; }
.dlv-card:hover { box-shadow: 0 6px 28px rgba(0,0,0,.09); transform: translateY(-2px); }
.dlv-card-stripe { width: 6px; flex-shrink: 0; }
.dlv-card-body { padding: 22px 24px; flex: 1; display: flex; gap: 20px; align-items: flex-start; }
.dlv-card-flag { font-size: 32px; flex-shrink: 0; margin-top: 2px; }
.dlv-card-info { flex: 1; }
.dlv-card-title { font-size: 16px; font-weight: 700; color: var(--td); margin-bottom: 5px; }
.dlv-card-subtitle { font-size: 13px; color: var(--tl); margin-bottom: 10px; line-height: 1.5; }
.dlv-card-pills { display: flex; flex-wrap: wrap; gap: 6px; }
.dlv-pill { display: inline-flex; align-items: center; gap: 5px; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; }
.dlv-card-time { text-align: right; flex-shrink: 0; }
.dlv-card-time-val { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: var(--td); white-space: nowrap; }
.dlv-card-time-unit { font-size: 11px; color: var(--tl); text-align: center; }
.dlv-card-price { font-size: 13px; font-weight: 600; margin-top: 6px; }

/* COLD CHAIN HIGHLIGHT */
.dlv-cold { background: linear-gradient(135deg, #EAF4FB, #D6EAF8); border: 1.5px solid #AED6F1; border-radius: 20px; padding: 32px 28px; margin-bottom: 48px; display: flex; gap: 24px; align-items: flex-start; }
.dlv-cold-icon { width: 56px; height: 56px; background: #2980B9; border-radius: 16px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.dlv-cold-icon svg { width: 30px; height: 30px; fill: #fff; }
.dlv-cold h3 { font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: #1A5276; margin-bottom: 8px; }
.dlv-cold p { font-size: 14px; color: #2471A3; line-height: 1.7; }
.dlv-cold-steps { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 14px; }
.dlv-cold-step { background: rgba(255,255,255,.7); border: 1px solid #AED6F1; border-radius: 10px; padding: 8px 14px; font-size: 12px; font-weight: 600; color: #1A5276; display: flex; align-items: center; gap: 6px; }

/* PRICE TABLE */
.dlv-table { width: 100%; border-collapse: collapse; border-radius: 14px; overflow: hidden; border: 1px solid var(--bo); }
.dlv-table th { background: var(--gd); color: #fff; padding: 14px 18px; text-align: left; font-size: 13px; font-weight: 600; letter-spacing: .3px; }
.dlv-table td { padding: 13px 18px; font-size: 13px; color: var(--tm); border-bottom: 1px solid var(--bo); }
.dlv-table tr:last-child td { border-bottom: none; }
.dlv-table tr:nth-child(even) td { background: var(--cr); }
.dlv-table-tag { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 700; }
.dlv-free { color: #2D6A2D; font-weight: 700; }
.dlv-express { color: #C0392B; font-weight: 700; }

/* PROCESS STEPS */
.dlv-process { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; position: relative; }
.dlv-process::before { content: ''; position: absolute; top: 28px; left: calc(12.5% + 10px); right: calc(12.5% + 10px); height: 2px; background: linear-gradient(90deg, var(--gl), #A8D8A0); z-index: 0; }
.dlv-step { text-align: center; padding: 0 8px; position: relative; z-index: 1; }
.dlv-step-dot { width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-size: 22px; border: 3px solid #fff; }
.dlv-step h4 { font-size: 13px; font-weight: 700; color: var(--td); margin-bottom: 5px; }
.dlv-step p { font-size: 11px; color: var(--tl); line-height: 1.5; }

/* FAQ MINI */
.dlv-faqs { display: grid; gap: 10px; }
.dlv-faq { border: 1px solid var(--bo); border-radius: 12px; overflow: hidden; }
.dlv-faq-q { width: 100%; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; background: #fff; border: none; cursor: pointer; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 600; color: var(--td); text-align: left; gap: 12px; }
.dlv-faq-q:hover { background: var(--cr); }
.dlv-faq-chevron { width: 18px; height: 18px; fill: var(--tl); transition: transform .25s; flex-shrink: 0; }
.dlv-faq.open .dlv-faq-chevron { transform: rotate(180deg); fill: var(--gl); }
.dlv-faq.open .dlv-faq-q { background: #F0F7EE; color: var(--gd); }
.dlv-faq-a { display: none; padding: 0 20px 16px; font-size: 13px; color: var(--tm); line-height: 1.7; }
.dlv-faq.open .dlv-faq-a { display: block; }

/* CTA */
.dlv-cta { background: linear-gradient(135deg, var(--gd) 0%, #1A5276 100%); border-radius: 24px; padding: 44px 36px; text-align: center; color: #fff; margin-top: 56px; }
.dlv-cta h3 { font-family: 'Playfair Display', serif; font-size: 28px; margin-bottom: 10px; }
.dlv-cta p { font-size: 15px; color: rgba(255,255,255,.75); margin-bottom: 28px; }
.dlv-cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.dlv-cta-btn { display: inline-flex; align-items: center; gap: 8px; padding: 14px 28px; border-radius: 12px; font-size: 14px; font-weight: 700; text-decoration: none; transition: all .2s; }
.dlv-cta-btn-main { background: #fff; color: var(--gd); }
.dlv-cta-btn-main:hover { background: #A8D8A0; }
.dlv-cta-btn-sec { background: rgba(255,255,255,.15); color: #fff; border: 1.5px solid rgba(255,255,255,.3); }
.dlv-cta-btn-sec:hover { background: rgba(255,255,255,.25); }

@media(max-width: 768px) {
  .dlv-hero h1 { font-size: 30px; }
  .dlv-stats { grid-template-columns: 1fr 1fr; gap: 10px; }
  .dlv-stat-val { font-size: 22px; }
  .dlv-process { grid-template-columns: 1fr 1fr; gap: 20px; }
  .dlv-process::before { display: none; }
  .dlv-cold { flex-direction: column; gap: 16px; }
  .dlv-card-body { flex-wrap: wrap; }
  .dlv-card-time { text-align: left; }
  .dlv-cta { padding: 32px 20px; }
  .dlv-cta h3 { font-size: 22px; }
}
@media(max-width: 480px) {
  .dlv-page { padding: 32px 16px 60px; }
  .dlv-stats { grid-template-columns: 1fr 1fr; }
  .dlv-process { grid-template-columns: 1fr 1fr; }
  .dlv-hero h1 { font-size: 26px; }
}
</style>

