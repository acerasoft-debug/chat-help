<!DOCTYPE html>
<html lang="{{ locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }} — Mondimart</title>
  {{ content_for_header }}
  {{ checkout_stylesheets }}
  {{ checkout_javascript }}
  <style>
    :root {
      --mm-green: #1A3C1A;
      --mm-gold: #C8A84B;
      --mm-gold-soft: #D4B85A;
      --mm-cream: #F5EFE3;
    }

    /* ── Checkout Header ── */
    .mm-co-header {
      background: #1A3C1A;
      padding: 0 24px;
      height: 66px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 12px rgba(0,0,0,0.25);
    }
    .mm-co-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      flex-shrink: 0;
    }
    .mm-co-logo svg { display: block; }
    .mm-co-wordmark {
      font-family: 'Fraunces', 'Playfair Display', Georgia, serif;
      font-size: 27px;
      font-weight: 500;
      color: #F5EFE3;
      letter-spacing: -0.5px;
      line-height: 1;
    }
    .mm-co-wordmark em {
      font-style: italic;
      font-weight: 400;
      color: #C8A84B;
    }
    .mm-co-secure {
      display: flex;
      align-items: center;
      gap: 7px;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 12px;
      color: rgba(245,239,227,0.65);
      font-weight: 500;
      letter-spacing: 0.02em;
    }

    /* ── Trust bar ── */
    .mm-co-trust {
      background: #f8fdf8;
      border-bottom: 1px solid #d8ead8;
      padding: 9px 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 11.5px;
      font-weight: 600;
      color: #2a6b2a;
    }
    .mm-co-trust span { display: flex; align-items: center; gap: 5px; }

    /* ── Override Shopify checkout button color ── */
    .btn--primary,
    .step__footer__continue-btn,
    button[type="submit"].btn--primary {
      background: #C8A84B !important;
      background-image: none !important;
      border-color: #C8A84B !important;
      color: #1A3C1A !important;
      font-weight: 700 !important;
      transition: background 0.2s ease !important;
    }
    .btn--primary:hover,
    .step__footer__continue-btn:hover {
      background: #D4B85A !important;
      border-color: #D4B85A !important;
    }

    /* ── Footer ── */
    .mm-co-footer {
      padding: 24px;
      text-align: center;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 11px;
      color: #aaa;
    }
    .mm-co-footer a { color: #888; text-decoration: none; }
    .mm-co-footer a:hover { text-decoration: underline; }
    .mm-co-footer-links { display: flex; justify-content: center; gap: 16px; margin-top: 6px; flex-wrap: wrap; }

    @media (max-width: 749px) {
      .mm-co-header { height: 56px; padding: 0 16px; }
      .mm-co-wordmark { font-size: 22px; }
      .mm-co-secure { font-size: 11px; }
      .mm-co-trust { gap: 12px; font-size: 11px; padding: 8px 16px; }
    }
  </style>
</head>
<body>

  <!-- ══ MONDIMART CHECKOUT HEADER ══ -->
  <div class="mm-co-header">
    <a href="{{ shop.url }}" class="mm-co-logo" aria-label="Mondimart — Retour au magasin">
      <!-- Globe icon mark -->
      <svg viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg" width="40" height="40">
        <circle cx="21" cy="21" r="18" stroke="#C8A84B" stroke-width="1.7"/>
        <ellipse cx="21" cy="21" rx="9" ry="18" stroke="#C8A84B" stroke-width="1.2"/>
        <line x1="3" y1="21" x2="39" y2="21" stroke="#C8A84B" stroke-width="1.2"/>
        <line x1="5.5" y1="14" x2="36.5" y2="14" stroke="#C8A84B" stroke-width="0.8"/>
        <line x1="5.5" y1="28" x2="36.5" y2="28" stroke="#C8A84B" stroke-width="0.8"/>
      </svg>
      <span class="mm-co-wordmark">Mondi<em>mart</em></span>
    </a>

    <div class="mm-co-secure">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
        <rect x="3" y="11" width="18" height="11" rx="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      Paiement sécurisé SSL 256-bit
    </div>
  </div>

  <!-- ══ TRUST BAR ══ -->
  <div class="mm-co-trust">
    <span>🔒 SSL 256-bit</span>
    <span>🚚 Livraison Express 24h</span>
    <span>✅ Halal certifié</span>
    <span>🇫🇷 Support français 7j/7</span>
    <span>↩️ Retour 14 jours</span>
  </div>

  {{ content_for_layout }}

  <!-- ══ CHECKOUT FOOTER ══ -->
  <div class="mm-co-footer">
    <div>© {{ 'now' | date: '%Y' }} Mondimart · Supermarché du Monde</div>
    <div class="mm-co-footer-links">
      <a href="{{ shop.url }}/pages/livraison">Livraison & retours</a>
      <a href="{{ shop.url }}/pages/faq">FAQ</a>
      <a href="{{ shop.url }}/policies/privacy-policy">Confidentialité</a>
      <a href="{{ shop.url }}/policies/refund-policy">Remboursements</a>
      <a href="{{ shop.url }}/pages/contact">Contact</a>
    </div>
  </div>

</body>
</html>
