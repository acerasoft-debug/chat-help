# VESTRA — Stripe credentials
# Copy this file to .env (one directory above public_html/) and fill in real values.
# NEVER commit .env to git.

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — get from Stripe Dashboard → Products → each product → Pricing section
PRICE_STARTER=price_...
PRICE_PRO=price_...
PRICE_PREMIUM=price_...
PRICE_ONBOARDING=price_...

# Set to 1 only after SEPA Direct Debit is activated and "qualified" on your Stripe account
SEPA_ENABLED=0
