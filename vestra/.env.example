# ─────────────────────────────────────────────────────────────────────────────
# VESTRA — Stripe yapılandırma şablonu / Stripe configuration template
#
# TR: Bu dosyayı ".env" adıyla, sitenin BİR ÜST klasörüne kopyala
#     (public_html İÇİNE DEĞİL — web'den erişilememesi için üstüne).
#     Örn: /home/KULLANICI/.env      (site /home/KULLANICI/public_html ise)
#     Değerleri Stripe Dashboard'dan al: https://dashboard.stripe.com
#
# EN: Copy this file as ".env" ONE LEVEL ABOVE the document root
#     (NOT inside public_html — so it can never be served over the web).
# ─────────────────────────────────────────────────────────────────────────────

# Developers → API keys  (test: sk_test_… / pk_test_…, canlı: sk_live_… / pk_live_…)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Developers → Webhooks → Add endpoint:
#   URL:    https://vestrasales.com/stripe/webhook.php
#   Events: checkout.session.completed, invoice.paid, invoice.payment_failed,
#           customer.subscription.updated, customer.subscription.deleted
# Endpoint oluşunca "Signing secret" (whsec_…) değerini buraya yapıştır:
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Products → her plan için bir Product + aylık Price oluştur (EUR, recurring):
#   Starter €19/ay · Pro €39/ay · Premium €89/ay   (membership.php'deki fiyatlarla aynı olmalı)
# Onboarding = tek seferlik €89 Price (one-time).
# Her birinin "API ID"si (price_…) buraya:
PRICE_STARTER=price_REPLACE_ME
PRICE_PRO=price_REPLACE_ME
PRICE_PREMIUM=price_REPLACE_ME
PRICE_ONBOARDING=price_REPLACE_ME

# SEPA banka ödemesi de sunulsun mu? (Stripe hesabında SEPA aktifse 1 yap)
SEPA_ENABLED=0
