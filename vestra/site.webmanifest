{
  "id": "/",
  "name": "VESTRA — B2B Fashion Wholesale",
  "short_name": "VESTRA",
  "description": "Verified B2B fashion wholesale marketplace — live prices, orders and messages.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?src=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "theme_color": "#0e0e11",
  "background_color": "#0e0e11",
  "categories": ["business", "shopping"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-badge-96.png", "sizes": "96x96", "type": "image/png", "purpose": "monochrome" }
  ],
  "shortcuts": [
    { "name": "Catalog", "short_name": "Catalog", "url": "/shop?src=pwa",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "My orders", "short_name": "Orders", "url": "/me?tab=orders&src=pwa",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Messages", "short_name": "Messages", "url": "/me?tab=messages&src=pwa",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Cart", "short_name": "Cart", "url": "/cart?src=pwa",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
