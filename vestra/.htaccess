# VESTRA — Apache config (Host Europe / cPanel, paylaşımlı hosting)
# Bu dosya document root'a (public_html) konur.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── /membership çakışması ──────────────────────────────────────────────
  # public_html/membership/ diye bir KLASÖR var (Stripe success + cancel sayfaları).
  # O yüzden /membership isteğini Apache klasör sanıp /membership/ adresine 301
  # atıyor, orada index olmadığı için 403 veriyor. DirectorySlash Off bu otomatik
  # slash-ekleme yönlendirmesini kapatır; alttaki kural da /membership'i doğrudan
  # fiyatlandırma sayfasına (membership.php) yönlendirir. /membership/success ve
  # /membership/cancel ise aşağıdaki genel *.php kuralıyla çalışmaya devam eder.
  DirectorySlash Off
  RewriteRule ^membership/?$ membership.php [L]

  # /shop de aynı durumda: public_html/shop/ diye bir klasör beliriyor ve aşağıdaki
  # genel kural "klasör varsa dokunma" (!-d) dediği için /shop kataloğu yerine
  # Options -Indexes'in 13 baytlık 403'ünü veriyor. Klasörü iki kez taşıdım; iki kez
  # geri geldi -- yani onu üreten şey deploy değil, ve nereden geldiğini bilmeden
  # üçüncü kez taşımak aynı arızayı üçüncü kez beklemek olurdu. Bu kural sorunu
  # kaynağından bağımsız kılıyor: /shop artık klasör var mı yok mu diye bakmadan
  # doğrudan shop.php'ye gidiyor. Klasör yerinde kalabilir, zararı yok.
  # (İçindeki farklı site ~/_golge-shop-20260809-123507 altında duruyor.)
  RewriteRule ^shop/?$ shop.php [L]

  # /sitemap.xml → dinamik sitemap.php
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # ── Temiz adresler: /shop  →  /shop.php (uzantı görünmez) ──────────────

  # index.php  →  /
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+index\.php[?\s] [NC]
  RewriteRule ^ / [R=301,L]

  # /sayfa.php  →  /sayfa   (sadece GET; form POST'ları *.php'ye gider, bozulmaz)
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.php[?\s] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /sayfa isteğini içeride /sayfa.php olarak sun
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]

  # ── HTTPS + www → apex (SSL aktif; sertifika sorunu olursa bu 5 satırı tekrar yorumla) ──
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# data/ ve vendor/ dizinlerini tarayıcıdan koru
<IfModule mod_rewrite.c>
  RewriteRule ^data/ - [F,L]
  RewriteRule ^vendor/ - [F,L]
</IfModule>

# Varsayılan açılış sayfası
DirectoryIndex index.php index.html

# Özel 404 sayfası
ErrorDocument 404 /404.php

# Dizin listelemesini kapat
Options -Indexes

# Temel güvenlik başlıkları
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
