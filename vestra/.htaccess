# VESTRA — Apache config (Host Europe / cPanel, paylaşımlı hosting)
# Bu dosya document root'a (public_html) konur.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── Temiz adresler: /shop  →  /shop.php (uzantı görünmez) ──────────────

  # index.php  →  /
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+index\.php[?\s] [NC]
  RewriteRule ^ / [R=301,L]

  # /sayfa.php  →  /sayfa   (sadece GET; form POST'ları *.php'ye gider, bozulmaz)
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.php[?\s] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /sayfa isteğini içeride /sayfa.php olarak sun
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]

  # ── HTTPS: AutoSSL gerçek sertifika verdikten SONRA aşağıdaki 5 satırın
  #    başındaki '# ' işaretlerini kaldır (SSL'den önce açma, döngü olur) ──
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# data/ ve vendor/ dizinlerini tarayıcıdan koru
<IfModule mod_rewrite.c>
  RewriteRule ^data/ - [F,L]
  RewriteRule ^vendor/ - [F,L]
</IfModule>

# Varsayılan açılış sayfası
DirectoryIndex index.php index.html

# Dizin listelemesini kapat
Options -Indexes

# Temel güvenlik başlıkları
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
