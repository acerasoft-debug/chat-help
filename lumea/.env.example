# Copy to .env and export before `npm start` (or set in your host's dashboard).
LUMEA_ORIGIN=https://lumea.spa          # canonical origin for SEO (sitemap, hreflang, JSON-LD)
LUMEA_BASE=                             # sub-path when hosted under /repo on GitHub Pages
PORT=4477
LUMEA_DATA_DIR=./.data                  # SQLite database + uploaded verification documents
LUMEA_ADMIN_EMAIL=admin@lumea.spa       # comma-separated; these accounts get the review-team role
LUMEA_GEOIP_URL=                        # optional, e.g. https://ipapi.co/{ip}/json/ — used when no edge geo headers exist
LUMEA_GSC=                              # Google Search Console verification token
LUMEA_BING=                             # Bing Webmaster verification token
LUMEA_PLAUSIBLE=                        # Plausible analytics domain
LUMEA_RESEND_KEY=                       # transactional mail via Resend; leave empty to write .eml files to <data dir>/outbox
LUMEA_MAIL_WEBHOOK=                     # or POST every mail as JSON to your own relay (Postmark, Brevo, n8n …)
LUMEA_MAIL_FROM="LUMÉA <concierge@lumea.spa>"
LUMEA_NO_RATELIMIT=                     # set to 1 only in tests
